</Base>

<script>
	const codeEl = document.getElementById("entity-jsonld-code");
	const copyBtns = [
		document.getElementById("header-copy-schema-btn"),
		document.getElementById("block-copy-schema-btn"),
	].filter(Boolean) as HTMLButtonElement[];

	copyBtns.forEach((btn) => {
		const labelSpan = btn.querySelector("[data-copy-label]");
		const originalText = labelSpan?.textContent || "Copy JSON-LD";

		btn.addEventListener("click", async () => {
			if (!codeEl?.textContent) return;
			try {
				await navigator.clipboard.writeText(codeEl.textContent);
				if (labelSpan) {
					labelSpan.textContent = "Copied to clipboard";
				}
				setTimeout(() => {
					if (labelSpan) {
						labelSpan.textContent = originalText;
					}
				}, 2200);
			} catch {
				// Fallback selection if clipboard permission is restricted
				const range = document.createRange();
				range.selectNodeContents(codeEl);
				const sel = window.getSelection();
				sel?.removeAllRanges();
				sel?.addRange(range);
			}
		});
	});
</script>

