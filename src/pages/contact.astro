---
import Base from "../layouts/Base.astro";

const directChannels = [
	{
		id: "zalo",
		badge: "FASTEST IN VIETNAM",
		label: "Zalo Direct",
		value: "0357.669.476",
		href: "https://zalo.me/0357669476",
		cta: "Message on Zalo ↗",
		external: true,
	},
	{
		id: "whatsapp",
		badge: "INTERNATIONAL",
		label: "WhatsApp",
		value: "+84 357 669 476",
		href: "https://wa.me/84357669476",
		cta: "Chat on WhatsApp ↗",
		external: true,
	},
	{
		id: "email",
		badge: "DETAILED BRIEFS",
		label: "Direct Email",
		value: "tinledoihoa@gmail.com",
		href: "mailto:tinledoihoa@gmail.com",
		cta: "Send email →",
		external: false,
	},
	{
		id: "linkedin",
		badge: "PROFESSIONAL NETWORK",
		label: "LinkedIn",
		value: "linkedin.com/in/tin-le-hoang",
		href: "https://www.linkedin.com/in/tin-le-hoang",
		cta: "Connect on LinkedIn ↗",
		external: true,
	},
];

const nextSteps = [
	{
		num: "01",
		title: "Initial Domain Review",
		description:
			"Before we speak, I inspect your domain's indexation footprint, core keyword rankings, and current AI assistant citation status across ChatGPT, Claude, and Perplexity.",
	},
	{
		num: "02",
		title: "Diagnostic Call & Scope",
		description:
			"A focused 30-minute working session to align on commercial KPIs, technical bottlenecks, and whether an Audit, Sprint, or Growth Retainer fits your team best.",
	},
	{
		num: "03",
		title: "Roadmap & Kickoff",
		description:
			"You receive a transparent scope with prioritized deliverables, sprint milestones, and target KPI benchmarks ready for immediate execution.",
	},
];
---

<Base
	title="Contact & Consulting Inquiry"
	description="Start an SEO or Generative Engine Optimization (GEO) engagement with Le Hoang Tin — technical SEO audits, AI citation sprints, and organic growth retainers."
>
	<div class="contact-page">
		<!-- ── Page Header ── -->
		<header class="page-header">
			<span class="editorial-kicker">DIRECT INQUIRY &amp; CONSULTATION</span>
			<h1 class="page-title">Start an SEO or GEO Engagement</h1>
			<p class="page-lead">
				Available for technical SEO audits, Generative Engine Optimization (GEO) citation sprints, and ongoing organic growth retainers across Vietnam, Australia, and global markets.
			</p>
			<div class="status-pill">
				<span class="status-dot" aria-hidden="true"></span>
				<span>Typical response time: Under 24 hours · HCMC (GMT+7)</span>
			</div>
		</header>

		<!-- ── Two-Column Layout (§ I & § II) ── -->
		<div class="contact-grid">
			<!-- Left Column: § I — Inquiry Brief -->
			<section class="inquiry-column" aria-labelledby="section-inquiry-brief">
				<div class="section-index-header">
					<span class="section-index-badge">§ I</span>
					<h2 class="section-index-title" id="section-inquiry-brief">
						Inquiry Brief
					</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
				</div>

				<div class="inquiry-card">
					<div id="prefill-context-banner" class="prefill-banner" hidden>
						<span class="prefill-kicker">CONTEXT PRE-LOADED</span>
						<p id="prefill-context-text" class="prefill-text"></p>
					</div>

					<form id="consulting-inquiry-form" class="inquiry-form">
						<div class="form-row-two">
							<div class="form-field">
								<label for="inquiry-name" class="field-label">
									Full Name <span class="required-mark" aria-hidden="true">*</span>
								</label>
								<input
									type="text"
									id="inquiry-name"
									name="name"
									class="field-input"
									placeholder="Your full name"
									required
									autocomplete="name"
								/>
							</div>

							<div class="form-field">
								<label for="inquiry-email" class="field-label">
									Work Email <span class="required-mark" aria-hidden="true">*</span>
								</label>
								<input
									type="email"
									id="inquiry-email"
									name="email"
									class="field-input"
									placeholder="you@company.com"
									required
									autocomplete="email"
								/>
							</div>
						</div>

						<div class="form-row-two">
							<div class="form-field">
								<label for="inquiry-phone" class="field-label">
									Phone / Zalo / WhatsApp
								</label>
								<input
									type="tel"
									id="inquiry-phone"
									name="phone"
									class="field-input"
									placeholder="e.g. 0357.669.476"
									autocomplete="tel"
								/>
							</div>

							<div class="form-field">
								<label for="inquiry-website" class="field-label">
									Website / Domain URL
								</label>
								<input
									type="text"
									id="inquiry-website"
									name="domain"
									class="field-input"
									placeholder="https://yourdomain.com"
									autocomplete="url"
								/>
							</div>
						</div>

						<div class="form-field">
							<label for="inquiry-model" class="field-label">
								Service / Engagement Topic
							</label>
							<select id="inquiry-model" name="engagement" class="field-select">
								<option value="Growth Retainer (Ongoing SEO & GEO)">
									Growth Retainer (Ongoing SEO &amp; GEO)
								</option>
								<option value="SEO & GEO Technical Audit">
									SEO &amp; GEO Technical Audit
								</option>
								<option value="Project-Based Sprint">
									Project-Based Sprint
								</option>
								<option value="AI Search / Citation Consulting">
									AI Search / Citation Consulting
								</option>
								<option value="Senior SEO & GEO Role / Hiring">
									Senior SEO &amp; GEO Role / Hiring
								</option>
								<option value="General Inquiry">
									General Inquiry
								</option>
							</select>
						</div>

						<div class="form-field">
							<label for="inquiry-goals" class="field-label">
								Project Goals &amp; Timeline
							</label>
							<textarea
								id="inquiry-goals"
								name="goals"
								class="field-textarea"
								rows="5"
								placeholder="Share your target market (VN, AU, Global), current organic or AI search bottlenecks, and desired timeline..."
							></textarea>
						</div>

						<div class="form-actions">
							<button type="submit" id="contact-submit-btn" class="btn-primary submit-btn">
								Get in Touch →
							</button>
							<p class="form-footnote">
								Delivers your message directly to <span class="mono-inline">tinledoihoa@gmail.com</span> with an instant <span class="mono-inline">mailto:</span> and one-click copy backup.
							</p>
						</div>
					</form>

					<!-- Inline Confirmation & Fallback Banner -->
					<div
						id="inquiry-confirmation"
						class="confirmation-banner"
						role="status"
						aria-live="polite"
						hidden
					>
						<div class="confirmation-header">
							<span class="confirmation-kicker">BRIEF PREPARED · READY TO SEND</span>
							<h3 class="confirmation-title">
								Your inquiry details have been formatted
							</h3>
							<p class="confirmation-desc">
								If your email client did not open automatically, copy your formatted brief below or send it directly via Zalo or WhatsApp for the fastest response.
							</p>
						</div>

						<pre id="inquiry-preview-box" class="confirmation-preview"></pre>

						<div class="confirmation-actions">
							<button
								type="button"
								id="copy-inquiry-btn"
								class="btn-primary copy-btn"
							>
								Copy inquiry details →
							</button>
							<a
								id="direct-mailto-fallback"
								href="mailto:tinledoihoa@gmail.com"
								class="btn-secondary"
							>
								Open email app →
							</a>
							<a
								href="https://zalo.me/0357669476"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-secondary"
							>
								Message on Zalo ↗
							</a>
							<a
								href="https://wa.me/84357669476"
								target="_blank"
								rel="noopener noreferrer"
								class="btn-secondary"
							>
								Chat on WhatsApp ↗
							</a>
						</div>
					</div>
				</div>
			</section>

			<!-- Right Column: § II — Instant Channels -->
			<section class="channels-column" aria-labelledby="section-instant-channels">
				<div class="section-index-header">
					<span class="section-index-badge">§ II</span>
					<h2 class="section-index-title" id="section-instant-channels">
						Instant Channels
					</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
				</div>

				<div class="channels-stack">
					<div class="channel-cards-grid">
						{
							directChannels.map((channel) => (
								<a
									href={channel.href}
									class="channel-card"
									target={channel.external ? "_blank" : undefined}
									rel={channel.external ? "noopener noreferrer" : undefined}
								>
									<div class="channel-card-top">
										<span class="channel-badge">{channel.badge}</span>
										<span class="channel-cta">{channel.cta}</span>
									</div>
									<span class="channel-label">{channel.label}</span>
									<span class="channel-value">{channel.value}</span>
								</a>
							))
						}
					</div>

					<!-- What Happens Next 3-Step Card -->
					<div class="process-card">
						<span class="editorial-kicker">ENGAGEMENT WORKFLOW</span>
						<h3 class="process-title">What happens next</h3>
						<ol class="process-steps">
							{
								nextSteps.map((step) => (
									<li class="process-step">
										<span class="step-num">{step.num}</span>
										<div class="step-body">
											<h4 class="step-heading">{step.title}</h4>
											<p class="step-desc">{step.description}</p>
										</div>
									</li>
								))
							}
						</ol>
					</div>
				</div>
			</section>
		</div>
	</div>
</Base>

<script>
	const form = document.getElementById("consulting-inquiry-form") as HTMLFormElement | null;
	const nameInput = document.getElementById("inquiry-name") as HTMLInputElement | null;
	const emailInput = document.getElementById("inquiry-email") as HTMLInputElement | null;
	const phoneInput = document.getElementById("inquiry-phone") as HTMLInputElement | null;
	const domainInput = (document.getElementById("inquiry-website") ||
		document.getElementById("inquiry-domain")) as HTMLInputElement | null;
	const modelSelect = document.getElementById("inquiry-model") as HTMLSelectElement | null;
	const goalsTextarea = document.getElementById("inquiry-goals") as HTMLTextAreaElement | null;
	const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;

	const prefillBanner = document.getElementById("prefill-context-banner");
	const prefillText = document.getElementById("prefill-context-text");

	const confirmationBanner = document.getElementById("inquiry-confirmation");
	const previewBox = document.getElementById("inquiry-preview-box");
	const copyBtn = document.getElementById("copy-inquiry-btn") as HTMLButtonElement | null;
	const mailtoFallback = document.getElementById("direct-mailto-fallback") as HTMLAnchorElement | null;

	const modelMap: Record<
		string,
		{ optionValue: string; banner: string; template: string }
	> = {
		audit: {
			optionValue: "SEO & GEO Technical Audit",
			banner: "Selected Tier 01: SEO & GEO Technical Audit (2–3 Weeks Delivery).",
			template:
				"Scope interest: SEO & GEO Technical Audit (crawl diagnostics, cannibalization analysis, and AI citation benchmark).\n\nTarget market & timeline:\n- ",
		},
		retainer: {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Selected Tier 02: Ongoing Growth Retainer (SEO & GEO Leadership).",
			template:
				"Scope interest: Monthly Growth Retainer (technical governance, semantic content clusters, and continuous GEO citation tracking).\n\nTarget market & monthly goals:\n- ",
		},
		sprint: {
			optionValue: "Project-Based Sprint",
			banner: "Selected Tier 03: Project-Based Sprint (4–8 Weeks Fixed Scope).",
			template:
				"Scope interest: Project-Based Sprint (ranking turnaround, site migration, or structured data & topical cluster launch).\n\nKey milestone & timeline:\n- ",
		},
	};

	const projectMap: Record<
		string,
		{ optionValue: string; banner: string; template: string }
	> = {
		"indochinalight": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: IndochinaLight (100% KPI in 3–5 mos · +409% Sales · Global E-Commerce).",
			template:
				"Reference Case Study: IndochinaLight (Global dropshipping e-commerce SEO across US, SG, IT, AU).\n\nWe are scaling an international storefront and need SEO/GEO leadership. Our goals:\n- ",
		},
		"furniture-global": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: IndochinaLight (100% KPI in 3–5 mos · +409% Sales · Global E-Commerce).",
			template:
				"Reference Case Study: IndochinaLight (Global dropshipping e-commerce SEO across US, SG, IT, AU).\n\nWe are scaling an international storefront and need SEO/GEO leadership. Our goals:\n- ",
		},
		"repair-au": {
			optionValue: "Project-Based Sprint",
			banner: "Reference Campaign: Repair Centre VIC (Top 3–5 Google AU in 2 Weeks · 85% KPI).",
			template:
				"Reference Case Study: Repair Centre VIC (Keyword cannibalization & duplicate content cleanup in Australia).\n\nWe need a technical turnaround sprint for our domain. Current bottleneck & timeline:\n- ",
		},
		"gtv-agency": {
			optionValue: "AI Search / Citation Consulting",
			banner: "Reference Campaign: GTV SEO (#1 ChatGPT, Grok & Claude Citations · 40 AI Articles/Mo).",
			template:
				"Reference Case Study: GTV SEO (Entity engineering, #1 AI assistant citation visibility & Top 1–3 Google rankings).\n\nWe want to improve our brand citations in ChatGPT/Claude/Perplexity alongside Google rankings. Our goals:\n- ",
		},
		"vinamilk": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: Vinamilk (300,000 clicks/month · 320,000 monthly traffic · 100% KPI).",
			template:
				"Reference Case Study: Vinamilk (Technical Audit, UI-UX, Topical Map & Onpage Checklist).\n\nWe are looking for a comparable strategy for our domain. Our primary goals & timeline:\n- ",
		},
		"shadow-vn": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: Shadow Vietnam (+25% MoM Revenue · 100% KPI · Military Supply Contract).",
			template:
				"Reference Case Study: Shadow Vietnam (Quarterly audits, Product Page Views & Time Onsite CRO).\n\nWe want to grow commercial e-commerce traffic and conversion rates. Our goals & timeline:\n- ",
		},
		"flashlight": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: Shadow Vietnam (+25% MoM Revenue · 100% KPI · Military Supply Contract).",
			template:
				"Reference Case Study: Shadow Vietnam (Quarterly audits, Product Page Views & Time Onsite CRO).\n\nWe want to grow commercial e-commerce traffic and conversion rates. Our goals & timeline:\n- ",
		},
		"eurotravel": {
			optionValue: "Growth Retainer (Ongoing SEO & GEO)",
			banner: "Reference Campaign: EuroTravel (100,000 monthly traffic · 80,000 GSC clicks/mo · 120% KPI).",
			template:
				"Reference Case Study: EuroTravel (European tour topical clusters & commercial route rankings).\n\nWe are looking to scale organic traffic and commercial conversions. Our goals & timeline:\n- ",
		},
	};

	function initUrlPrefill() {
		const params = new URLSearchParams(window.location.search);
		const modelKey = (params.get("model") || "").toLowerCase().trim();
		const projectKey = (params.get("project") || "").toLowerCase().trim();
		const domainParam = (params.get("domain") || "").trim();
		const scoreParam = (params.get("score") || "").trim();

		const matched = projectMap[projectKey] || modelMap[modelKey];
		const bannerParts: string[] = [];

		if (matched) {
			if (modelSelect) {
				modelSelect.value = matched.optionValue;
			}
			if (goalsTextarea && !goalsTextarea.value.trim()) {
				goalsTextarea.value = matched.template;
			}
			bannerParts.push(matched.banner);
		}

		if (domainParam && domainInput) {
			domainInput.value = domainParam;
			bannerParts.push(`Target Domain: ${domainParam}`);
		}

		if (scoreParam && goalsTextarea) {
			const scoreContext = `Completed the SEO & GEO Readiness Scorecard (Score: ${scoreParam}/100)`;
			if (!goalsTextarea.value.includes("Completed the SEO & GEO Readiness Scorecard")) {
				const existing = goalsTextarea.value.trim();
				goalsTextarea.value = existing
					? `${existing}\n\n${scoreContext}`
					: `${scoreContext}\n\nPrimary goals & timeline:\n- `;
			}
			bannerParts.push(`Diagnostic Score: ${scoreParam}/100`);
		}

		if (bannerParts.length > 0 && prefillBanner && prefillText) {
			prefillText.textContent = bannerParts.join(" · ");
			prefillBanner.hidden = false;
		}
	}

	initUrlPrefill();

	let latestFormattedBrief = "";

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();

		const name = nameInput?.value.trim() || "Prospective Client";
		const email = emailInput?.value.trim() || "";
		const phone = phoneInput?.value.trim() || "Not specified";
		const domain = domainInput?.value.trim() || "Not specified";
		const engagement =
			modelSelect?.value || "Growth Retainer (Ongoing SEO & GEO)";
		const goals =
			goalsTextarea?.value.trim() ||
			"Let's discuss scope, goals, and timeline on an initial call.";

		const subject = `[SEO/GEO Inquiry] ${engagement} — ${domain !== "Not specified" ? domain : name}`;
		const bodyLines = [
			"Hi Tin,",
			"",
			"I would like to discuss an SEO / GEO engagement.",
			"",
			"--- INQUIRY BRIEF ---",
			`Name: ${name}`,
			`Work Email: ${email}`,
			`Phone / Zalo: ${phone}`,
			`Website / Domain: ${domain}`,
			`Service / Topic: ${engagement}`,
			"",
			"Project Goals & Timeline:",
			goals,
			"---------------------",
		];

		latestFormattedBrief = bodyLines.join("\n");
		const mailtoHref = `mailto:tinledoihoa@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(latestFormattedBrief)}`;

		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = "Sending to tinledoihoa@gmail.com...";
		}

		try {
			await fetch("https://formsubmit.co/ajax/tinledoihoa@gmail.com", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				body: JSON.stringify({
					_subject: subject,
					name,
					email,
					phone,
					website: domain,
					service: engagement,
					message: goals,
				}),
			});
		} catch {
			// Fallback to mailto/copy preview below if offline or blocked
		}

		if (submitBtn) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Inquiry Sent — Send Another →";
		}

		if (previewBox) {
			previewBox.textContent = latestFormattedBrief;
		}
		if (mailtoFallback) {
			mailtoFallback.href = mailtoHref;
		}
		if (confirmationBanner) {
			confirmationBanner.hidden = false;
			confirmationBanner.scrollIntoView({ behavior: "smooth", block: "nearest" });
		}
	});

	copyBtn?.addEventListener("click", async () => {
		if (!latestFormattedBrief) return;
		try {
			await navigator.clipboard.writeText(latestFormattedBrief);
			const originalText = copyBtn.textContent;
			copyBtn.textContent = "Copied inquiry details ✓";
			setTimeout(() => {
				copyBtn.textContent = originalText || "Copy inquiry details →";
			}, 2500);
		} catch {
			// Fallback selection if clipboard permission is denied
			if (previewBox) {
				const range = document.createRange();
				range.selectNodeContents(previewBox);
				const selection = window.getSelection();
				selection?.removeAllRanges();
				selection?.addRange(range);
			}
		}
	});
</script>

<style>
	.contact-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-24);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-14, 3.5rem);
	}

	/* ── Page Header ── */
	.page-header {
		max-width: 780px;
		padding-bottom: var(--spacing-10);
		border-bottom: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 4.8vw, 3.5rem);
		font-weight: 600;
		font-style: normal;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.page-lead {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 64ch;
		margin-bottom: var(--spacing-6);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: 6px var(--spacing-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-text-secondary);
		box-shadow: var(--shadow-tile-raised);
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #2e7d32;
		box-shadow: 0 0 0 3px color-mix(in srgb, #2e7d32 22%, transparent);
		flex-shrink: 0;
	}

	/* ── Two-Column Grid ── */
	.contact-grid {
		display: grid;
		grid-template-columns: 1.25fr 0.95fr;
		gap: var(--spacing-10);
		align-items: start;
	}

	/* ── Left Column: Inquiry Card & Form ── */
	.inquiry-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		box-shadow: var(--shadow-tile-raised);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.prefill-banner {
		background: color-mix(in srgb, var(--color-amber) 10%, var(--color-bg-subtle));
		border: 1px solid color-mix(in srgb, var(--color-amber) 35%, var(--color-border));
		border-radius: 8px;
		padding: var(--spacing-3) var(--spacing-4);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.prefill-kicker {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
