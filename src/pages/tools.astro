		flex-direction: column;
		gap: var(--spacing-20);
	}

	/* ── Editorial Header ── */
	.page-header {
		max-width: 840px;
		padding-bottom: var(--spacing-10);
		border-bottom: 1px solid var(--color-border);
	}

