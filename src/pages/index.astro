							id="home-form-confirmation"
							class="touch-confirmation"
							role="status"
							aria-live="polite"
							hidden
						>
							<span class="editorial-kicker">MESSAGE DISPATCHED · READY</span>
							<h4 class="touch-conf-title">
								Thank you! Your message has been sent to tinledoihoa@gmail.com.
							</h4>
							<p class="touch-conf-desc">
								You can also open this pre-filled message in your email app or copy it for Zalo / WhatsApp:
							</p>
							<pre id="home-form-preview" class="touch-conf-preview"></pre>
							<div class="touch-conf-actions">
								<a
									id="home-mailto-link"
									href="mailto:tinledoihoa@gmail.com"
									class="btn-primary"
								>
									Open in Email App (mailto:tinledoihoa@gmail.com) →
								</a>
								<button
									type="button"
									id="home-copy-msg-btn"
									class="btn-secondary"
								>
									Copy Message →
								</button>
							</div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
</Base>

<script>
	// Pre-select service when clicking Engagement Tier "Get in Touch" buttons
	const serviceSelect = document.getElementById("home-service") as HTMLSelectElement | null;
	const messageInput = document.getElementById("home-message") as HTMLTextAreaElement | null;
	const tierButtons = document.querySelectorAll<HTMLAnchorElement>("[data-select-service]");

	tierButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const val = btn.dataset.selectService;
			if (val && serviceSelect) {
				serviceSelect.value = val;
			}
			setTimeout(() => {
				messageInput?.focus();
			}, 350);
		});
	});

	// Interactive Get in Touch Form submission (AJAX to formsubmit.co + mailto/copy fallback)
	const homeForm = document.getElementById("home-get-in-touch-form") as HTMLFormElement | null;
	const nameEl = document.getElementById("home-name") as HTMLInputElement | null;
	const emailEl = document.getElementById("home-email") as HTMLInputElement | null;
	const phoneEl = document.getElementById("home-phone") as HTMLInputElement | null;
	const websiteEl = document.getElementById("home-website") as HTMLInputElement | null;
	const submitBtn = document.getElementById("home-submit-btn") as HTMLButtonElement | null;
	const confBox = document.getElementById("home-form-confirmation");
	const previewPre = document.getElementById("home-form-preview");
	const mailtoLink = document.getElementById("home-mailto-link") as HTMLAnchorElement | null;
	const copyMsgBtn = document.getElementById("home-copy-msg-btn") as HTMLButtonElement | null;

	let formattedMessageText = "";

	homeForm?.addEventListener("submit", async (e) => {
		e.preventDefault();

		const name = nameEl?.value.trim() || "Prospective Client";
		const email = emailEl?.value.trim() || "";
		const phone = phoneEl?.value.trim() || "Not specified";
		const website = websiteEl?.value.trim() || "Not specified";
		const service = serviceSelect?.value || "SEO & GEO Inquiry";
		const message = messageInput?.value.trim() || "";

		const subject = `[Get in Touch — tinlehoang.info.vn] ${service} — ${name}`;
		formattedMessageText = [
			"Hi Tin,",
			"",
			`Name: ${name}`,
			`Email: ${email}`,
			`Phone / Zalo: ${phone}`,
			`Website URL: ${website}`,
			`Service / Topic: ${service}`,
			"",
			"Message:",
			message,
		].join("\n");

		const mailtoUrl = `mailto:tinledoihoa@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(formattedMessageText)}`;

		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = "Sending to tinledoihoa@gmail.com...";
		}

		try {
			await fetch("https://formsubmit.co/ajax/tinledoihoa@gmail.com", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					Accept: "application/json",
				},
				body: JSON.stringify({
					_subject: subject,
					name,
					email,
					phone,
					website,
					service,
					message,
				}),
			});
		} catch {
			// Offline or blocked; inline confirmation & mailto fallback still available
		}

		if (submitBtn) {
			submitBtn.disabled = false;
			submitBtn.textContent = "Message Sent — Send Another →";
		}

		if (previewPre) {
			previewPre.textContent = formattedMessageText;
		}
		if (mailtoLink) {
			mailtoLink.href = mailtoUrl;
		}
		if (confBox) {
			confBox.hidden = false;
			confBox.scrollIntoView({ behavior: "smooth", block: "nearest" });
		}
	});

	copyMsgBtn?.addEventListener("click", async () => {
		if (!formattedMessageText) return;
		try {
			await navigator.clipboard.writeText(formattedMessageText);
			const orig = copyMsgBtn.textContent;
			copyMsgBtn.textContent = "Copied to clipboard ✓";
			setTimeout(() => {
				copyMsgBtn.textContent = orig || "Copy Message →";
			}, 2200);
		} catch {
			// Ignore clipboard error
		}
	});
</script>

