import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 7,
	}),
	getSiteSettings(),
]);

Astro.cache.set(cacheHint);

// Batch-fetch categories using database ULID (post.data.id)
const postIds = posts.map((p) => p.data.id);
const categoriesByEntry =
	postIds.length > 0
		? await getTermsForEntries("posts", postIds, "category")
		: new Map();

const featuredPost = posts[0] ?? null;
const listPosts = posts.slice(1);

// Date → YYYY·MM·DD
function formatDate(date: Date | null | undefined): string {
	if (!date) return "";
	return date.toISOString().slice(0, 10).replace(/-/g, "·");
}

function getFirstCategory(entryDataId: string) {
	const cats = categoriesByEntry.get(entryDataId);
	return cats && cats.length > 0 ? cats[0] : null;
}

function formatIssueNumber(
	num: number | null | undefined,
	fallback: number,
): string {
	return String(num ?? fallback).padStart(2, "0");
}

