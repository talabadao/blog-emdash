	.case-badge-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		flex-wrap: wrap;
		margin-bottom: 4px;
	}

	.case-num {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-muted);
	}

	.case-market-tag {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		border-radius: var(--radius);
		padding: 1px 6px;
	}

	.case-timeline-mono {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-muted);
		margin-left: auto;
	}

	.case-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		margin: 2px 0;
	}

	.case-title-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.case-logo-badge {
		width: 115px;
		height: 46px;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: #ffffff;
		overflow: hidden;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.case-logo-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.case-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: 600;
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.case-subtitle {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-accent);
	}

	.case-role-badge {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-text-secondary);
	}

	.case-metrics-three {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-2);
		padding: var(--spacing-3);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border-subtle);
		border-radius: calc(var(--radius-lg) - 4px);
	}

	.case-metric-box {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.case-metric-value {
		font-family: var(--font-mono);
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-accent);
		line-height: 1.15;
	}

	.case-metric-label {
		font-family: var(--font-sans);
		font-size: 0.7rem;
		color: var(--color-text-secondary);
		line-height: 1.25;
	}

	.case-task-result {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		flex: 1;
	}

	.case-line {
		font-size: var(--font-size-xs);
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.case-line strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.case-proof-preview {
		position: relative;
		display: block;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
		text-decoration: none;
	}

	.case-proof-img {
		width: 100%;
		height: 130px;
		object-fit: cover;
		object-position: left top;
		display: block;
	}

	.case-proof-badge {
		display: block;
		padding: 4px var(--spacing-3);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--color-text);
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border-subtle);
	}

	.case-card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: var(--spacing-3);
		border-top: 1px solid var(--color-border-subtle);
	}

	.case-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.case-deck-link {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.section-bottom-bar {
		margin-top: var(--spacing-8);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	/* ── 5. § III — Services & Engagement Tiers ── */
	.capabilities-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-6);
	}

	.capability-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
		box-shadow: var(--shadow-tile-raised);
	}

	.capability-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
	}

	.capability-num {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		border-radius: var(--radius);
		padding: 2px var(--spacing-2);
	}

	.capability-kicker {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.capability-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: var(--leading-snug);
		color: var(--color-text);
	}

	.capability-desc {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		flex: 1;
	}

	.capability-foot {
		padding-top: var(--spacing-4);
		border-top: 1px solid var(--color-border-subtle);
	}

	.capability-deliverables {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-muted);
		line-height: var(--leading-normal);
	}

	.tiers-subblock {
		margin-top: var(--spacing-12);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.tiers-subheader {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.tiers-heading {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 600;
		color: var(--color-text);
	}

	.tiers-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-6);
		align-items: stretch;
	}

	.tier-card {
		position: relative;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
		box-shadow: var(--shadow-tile-raised);
	}

	.tier-card.featured {
		border: 2px solid var(--color-accent);
		box-shadow: var(--shadow-feature);
		background: color-mix(in srgb, var(--color-accent) 4%, var(--color-surface));
	}

	.tier-rec-badge {
		position: absolute;
		top: var(--spacing-4);
		right: var(--spacing-4);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		background: var(--color-accent);
		color: var(--color-on-accent);
		padding: 2px 10px;
		border-radius: var(--radius-full);
	}

	.tier-head {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.tier-timeline {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-amber);
	}

	.tier-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.25;
		color: var(--color-text);
	}

	.tier-blurb {
		font-size: var(--font-size-xs);
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.tier-features {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
		padding-top: var(--spacing-3);
		border-top: 1px solid var(--color-border-subtle);
		flex: 1;
	}

	.tier-features li {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-2);
		font-size: var(--font-size-xs);
		line-height: 1.45;
		color: var(--color-text-secondary);
	}

	.tier-foot {
		padding-top: var(--spacing-3);
	}

	.tier-cta-btn {
		width: 100%;
	}

	/* ── 6. § IV — Writing & Research ── */
	.writing-layout {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-10);
	}

	.featured-card {
		display: block;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-tile-raised);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base),
			transform var(--transition-base);
	}

	.featured-card:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-feature);
	}

	.featured-card-grid {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: var(--spacing-8);
		align-items: stretch;
	}

	.featured-card-aside {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--spacing-4);
		padding-right: var(--spacing-6);
		border-right: 1px solid var(--color-border-subtle);
	}

	.featured-meta-top,
	.featured-meta-bottom {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-2);
	}

	.article-num-badge {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
	}

	.category-tag {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		border-radius: var(--radius);
		padding: 2px var(--spacing-2);
	}

	.article-date-mono {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.article-read-time {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.featured-card-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.featured-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: var(--spacing-2);
	}

	.featured-card-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.8vw, 2.125rem);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin-bottom: var(--spacing-3);
		transition: color var(--transition-fast);
	}

	.featured-card:hover .featured-card-title {
		color: var(--color-accent);
	}

	.featured-card-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-5);
		max-width: 65ch;
	}

	.featured-cta {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
	}

	/* ── Numbered Article Index ── */
	.articles-index {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2) var(--spacing-6);
		box-shadow: var(--shadow-tile-raised);
	}

	.articles-list {
		display: flex;
		flex-direction: column;
	}

	.article-row {
		display: grid;
		grid-template-columns: 3.75rem 7.25rem 6.5rem 1fr 4rem;
		align-items: baseline;
		gap: var(--spacing-4);
		padding: var(--spacing-4) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		text-decoration: none;
		color: inherit;
		transition: background var(--transition-fast);
	}

	.article-row:last-child {
		border-bottom: none;
	}

	.article-row:hover .article-title-col {
		color: var(--color-accent);
	}

	.article-num {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-muted);
	}

	.article-cat {
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-amber);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-title-col {
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: 500;
		line-height: var(--leading-snug);
		color: var(--color-text);
		transition: color var(--transition-fast);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.article-time {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		text-align: right;
		white-space: nowrap;
	}

	.see-all-row {
		padding: var(--spacing-4) 0 var(--spacing-2);
		border-top: 1px solid var(--color-border-subtle);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.see-all-link {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	/* ── 7. § V — FAQ Accordion ── */
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.faq-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-tile-raised);
		overflow: hidden;
	}

	.faq-item[open] {
		border-color: var(--color-accent);
	}

	.faq-question {
		list-style: none;
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		padding: var(--spacing-5) var(--spacing-6);
		cursor: pointer;
		user-select: none;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-num {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-amber);
		flex-shrink: 0;
	}

	.faq-question-text {
		font-family: var(--font-heading);
		font-size: var(--font-size-base);
		font-weight: 600;
		color: var(--color-text);
		flex: 1;
	}

	.faq-icon::before {
		content: "+";
		font-family: var(--font-mono);
		font-size: var(--font-size-lg);
		font-weight: 600;
		color: var(--color-accent);
	}

	.faq-item[open] .faq-icon::before {
		content: "−";
	}

	.faq-answer-wrap {
		padding: 0 var(--spacing-6) var(--spacing-5) calc(var(--spacing-6) + 2rem);
	}

	.faq-answer {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	/* ── 8. § VI — Get in Touch ── */
	.get-in-touch-grid {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: var(--spacing-8);
		align-items: stretch;
	}

	.touch-left-card,
	.touch-form-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		box-shadow: var(--shadow-tile-raised);
		display: flex;
		flex-direction: column;
	}

	.touch-left-card {
		background: var(--color-bg-subtle);
	}

	.touch-heading,
	.touch-form-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-text);
		margin-bottom: var(--spacing-3);
	}

	.touch-desc {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-6);
	}

	.touch-channel-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border);
		margin-bottom: var(--spacing-6);
	}

	.touch-channel-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.touch-channel-item dt {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-muted);
	}

	.touch-channel-item dd {
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.touch-channel-item a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.channel-sep {
		color: var(--color-muted);
	}

	.touch-left-actions {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.touch-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.touch-row-two {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-4);
	}

	.touch-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.touch-label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text);
	}

	.req-star {
		color: var(--color-accent);
	}

	.touch-input,
	.touch-select {
		height: 42px;
		padding: 0 var(--spacing-3);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 8px;
	}

	.touch-textarea {
		padding: var(--spacing-3);
		font-family: var(--font-sans);
		font-size: var(--font-size-sm);
		line-height: 1.5;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		resize: vertical;
