---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 7,
	}),
	getSiteSettings(),
]);

Astro.cache.set(cacheHint);

// Batch-fetch categories using database ULID (post.data.id)
const postIds = posts.map((p) => p.data.id);
const categoriesByEntry =
	postIds.length > 0
		? await getTermsForEntries("posts", postIds, "category")
		: new Map();

const featuredPost = posts[0] ?? null;
const listPosts = posts.slice(1);

// Date → YYYY·MM·DD
function formatDate(date: Date | null | undefined): string {
	if (!date) return "";
	return date.toISOString().slice(0, 10).replace(/-/g, "·");
}

function getFirstCategory(entryDataId: string) {
	const cats = categoriesByEntry.get(entryDataId);
	return cats && cats.length > 0 ? cats[0] : null;
}

function formatIssueNumber(
	num: number | null | undefined,
	fallback: number
): string {
	return String(num ?? fallback).padStart(2, "0");
}

const proofStats = [
	{
		value: "3+ yrs",
		label: "Leading SEO & GEO strategy at GTV SEO Agency",
	},
	{
		value: "#1 AI Cited",
		label: 'Recommended on ChatGPT, Claude & Grok for "SEO agency HCMC"',
	},
	{
		value: "300K+",
		label: "Monthly organic clicks scaled for enterprise FMCG",
	},
	{
		value: "100%+",
		label: "KPI delivery rate across 6+ multi-market campaigns",
	},
];

const campaignMarkets = [
	"GTV SEO (VN)",
	"Vinamilk (FMCG)",
	"EuroTravel (Travel)",
	"Repair Centre VIC (AU)",
	"Global E-Commerce (US/Global)",
];

const selectedCaseStudies = [
	{
		name: "GTV SEO Agency",
		domain: "gtvseo.com",
		tag: "GEO & B2B SEO · Vietnam",
		metrics: [
			{ value: "#1", label: "ChatGPT / Claude / Grok" },
			{ value: "Top 1–3", label: "Core Keywords" },
		],
		summary:
			"Engineered entity authority and white-hat topical depth to secure #1 AI assistant citations for 'SEO agency HCMC' while defending Top 1–3 Google rankings across competitive B2B search terms.",
		href: "/posts/three-years-at-gtv-seo-what-i-learned",
		cta: "Read breakdown →",
	},
	{
		name: "Repair Centre VIC",
		domain: "repaircentrevic.com.au",
		tag: "Local & Technical SEO · Australia",
		metrics: [
			{ value: "Top 3–5", label: "in 14 Days" },
			{ value: "85% KPI", label: "in Month 1" },
		],
		summary:
			"Resolved severe keyword cannibalization and duplicate indexation in a final-sprint turnaround, pairing on-page consolidation with LocalBusiness JSON-LD and a Google Business Profile overhaul.",
		href: "/posts/top-3-rankings-in-two-weeks",
		cta: "Read case study →",
	},
	{
		name: "Vinamilk Nutrition",
		domain: "vinamilk.com.vn",
		tag: "Enterprise E-Commerce · FMCG",
		metrics: [
			{ value: "300K", label: "Clicks / Month" },
			{ value: "100% KPI", label: "Achieved" },
		],
		summary:
			"Architected a full-funnel topical map, semantic content clusters, and on-page technical standards for the maternal and baby nutrition vertical to capture Top 1–3 rankings at enterprise scale.",
		href: "/posts/scaling-vinamilk-to-300k-monthly-organic-clicks",
		cta: "Read case study →",
	},
];

const capabilities = [
	{
		index: "01",
		kicker: "AI Citation Engineering",
		title: "GEO & AI Search Optimization",
		description:
			"Entity structuring, llms.txt architecture, and citation engineering so your brand is recommended by ChatGPT, Claude, Perplexity, and Google AI Overviews.",
		deliverables: "Entity Graphs · llms.txt · Brand Citation Audits",
	},
	{
		index: "02",
		kicker: "Crawl & Indexation",
		title: "Technical SEO & Site Architecture",
		description:
			"Deep crawl diagnostics (Screaming Frog, GSC), indexation cleanup, Core Web Vitals, schema graphs, and international/local SEO foundations.",
		deliverables: "Crawl Diagnostics · JSON-LD · Core Web Vitals",
	},
	{
		index: "03",
		kicker: "Topical Maps & Revenue",
		title: "Topic Authority & Conversion (CRO)",
		description:
			"Intent-mapped content clusters, competitive gap execution (Ahrefs/SEMrush), and GA4 funnel optimization that turns organic traffic into pipeline.",
		deliverables: "Semantic Clusters · Cannibalization Fixes · GA4 Funnels",
	},
];
---

<Base title={settings.title ?? "Le Hoang Tin"} description={settings.tagline}>
	<div class="home">

		<!-- ── 1. Hero Section ── -->
		<section class="hero">
			<div class="hero-masthead">
				<span class="vol-badge">VOL. I — 2026</span>
				<span class="masthead-rule" aria-hidden="true"></span>
				<span class="city-label">HO CHI MINH CITY, VN</span>
			</div>

			<div class="hero-inner">
				<div class="hero-text">
					<span class="editorial-kicker">SENIOR SEO &amp; GEO SPECIALIST</span>

					<h1 class="hero-name">Le Hoang Tin</h1>

					<p class="hero-positioning">
						Helping brands rank at the top of Google and get cited inside ChatGPT, Claude, Perplexity, and Google AI Overviews.
					</p>

					<p class="hero-bio">
						Senior SEO &amp; GEO Specialist with 3+ years leading organic growth at GTV SEO Agency across Vietnam, Australia, and global English markets. Focused on entity architecture, technical SEO, and measurable revenue impact.
					</p>

					<div class="hero-ctas">
						<a href="/contact" class="btn-primary">
							Work with me →
						</a>
						<a href="/projects" class="btn-secondary">
							Explore case studies →
						</a>
					</div>

					{
						featuredPost && (
							<div class="hero-latest-row">
								<a href={`/posts/${featuredPost.id}`} class="hero-latest-link">
									<span class="hero-latest-prefix">Latest essay:</span>
									<span class="hero-latest-title">{featuredPost.data.title} →</span>
								</a>
							</div>
						)
					}
				</div>

				<div class="hero-portrait">
					<div class="portrait-card">
						<div class="portrait-frame">
							<img
								src="/tin_le_hoang.jpg"
								alt="Le Hoang Tin — Senior SEO & GEO Specialist in Ho Chi Minh City"
								class="portrait-img"
								width="240"
								height="260"
								loading="eager"
							/>
						</div>
						<div class="portrait-meta">
							<p class="portrait-caption">FIG. 01 — LE HOANG TIN · HCMC</p>
							<div class="status-pill">
								<span class="status-dot" aria-hidden="true"></span>
								<span>Available for consulting &amp; GEO audits</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ── 2. Proof & Brand Strip ── -->
		<section class="proof-strip" aria-label="Verified SEO and GEO impact metrics">
			<div class="proof-grid">
				{
					proofStats.map((stat) => (
						<div class="proof-item">
							<span class="proof-value">{stat.value}</span>
							<span class="proof-label">{stat.label}</span>
						</div>
					))
				}
			</div>

			<div class="brand-strip">
				<span class="brand-strip-label">CAMPAIGN EXPERIENCE &amp; MARKETS</span>
				<div class="brand-strip-list" role="list">
					{
						campaignMarkets.map((item, index) => (
							<>
								<span class="brand-strip-item" role="listitem">{item}</span>
								{index < campaignMarkets.length - 1 && (
									<span class="brand-strip-sep" aria-hidden="true">·</span>
								)}
							</>
						))
					}
				</div>
			</div>
		</section>

		<div class="main-sections">

			<!-- ── 3. § I — Writing & Research ── -->
			<section class="writing-section" aria-labelledby="section-writing-title">
				<div class="section-index-header">
					<span class="section-index-badge">§ I</span>
					<h2 class="section-index-title" id="section-writing-title">Writing · SEO &amp; AI Search</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
					<a href="/posts" class="section-index-link">
						Full archive ({posts.length}+) →
					</a>
				</div>

				{
					featuredPost ? (
						<div class="writing-layout">
							{/* Featured Essay Card */}
							<a href={`/posts/${featuredPost.id}`} class="featured-card">
								<div class="featured-card-grid">
									<div class="featured-card-aside">
										<div class="featured-meta-top">
											<span class="article-num-badge">
												№ {formatIssueNumber(featuredPost.data.number, posts.length)}
											</span>
											{getFirstCategory(featuredPost.data.id) && (
												<span class="category-tag">
													{getFirstCategory(featuredPost.data.id)!.label}
												</span>
											)}
										</div>
										<div class="featured-meta-bottom">
											{featuredPost.data.publishedAt && (
												<time class="article-date-mono">
													{formatDate(featuredPost.data.publishedAt)}
												</time>
											)}
											<span class="article-read-time">
												{getReadingTime(featuredPost.data.content)} min read
											</span>
										</div>
									</div>

									<div class="featured-card-body">
										<span class="featured-eyebrow">Featured Essay</span>
										<h3 class="featured-card-title">
											{featuredPost.data.title}
										</h3>
										{featuredPost.data.excerpt && (
											<p class="featured-card-excerpt">
												{featuredPost.data.excerpt}
											</p>
										)}
										<span class="featured-cta">Read essay →</span>
									</div>
								</div>
							</a>

							{/* Numbered Article Index */}
							{listPosts.length > 0 && (
								<div class="articles-index">
									<div class="articles-list" role="list">
										{listPosts.map((post, idx) => {
											const cat = getFirstCategory(post.data.id);
											const num = formatIssueNumber(
												post.data.number,
												listPosts.length - idx
											);
											return (
												<a
													href={`/posts/${post.id}`}
													class="article-row"
													role="listitem"
												>
													<span class="article-num">№ {num}</span>
													<time class="article-date-mono">
														{formatDate(post.data.publishedAt)}
													</time>
													{cat ? (
														<span class="article-cat">{cat.label}</span>
													) : (
														<span class="article-cat" />
													)}
													<span class="article-title-col">
														{post.data.title}
													</span>
													<span class="article-time">
														{getReadingTime(post.data.content)} min
													</span>
												</a>
											);
										})}
									</div>

									<div class="see-all-row">
										<a href="/posts" class="see-all-link">
											Browse all articles →
										</a>
									</div>
								</div>
							)}
						</div>
					) : (
						<div class="empty-state">
							<p>No essays published yet.</p>
							<a href="/_emdash/admin/content/posts/new" class="btn-primary">
								Create first post →
							</a>
						</div>
					)
				}
			</section>

			<!-- ── 4. § II — Selected Case Studies ── -->
			<section class="work-section" aria-labelledby="section-work-title">
				<div class="section-index-header">
					<span class="section-index-badge">§ II</span>
					<h2 class="section-index-title" id="section-work-title">Selected Case Studies · Verifiable Impact</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
					<a href="/projects" class="section-index-link">All 6 projects →</a>
				</div>

				<div class="work-grid">
					{
						selectedCaseStudies.map((study) => (
							<article class="case-card">
								<div class="case-card-top">
									<span class="case-tag">{study.tag}</span>
									<h3 class="case-title">{study.name}</h3>
									<span class="case-domain">{study.domain}</span>
								</div>

								<div class="case-metrics">
									{study.metrics.map((metric) => (
										<div class="case-metric-box">
											<span class="case-metric-value">{metric.value}</span>
											<span class="case-metric-label">{metric.label}</span>
										</div>
									))}
								</div>

								<p class="case-summary">{study.summary}</p>

								<a href={study.href} class="case-link">
									{study.cta}
								</a>
							</article>
						))
					}
				</div>
			</section>

			<!-- ── 5. § III — Capabilities & Consulting ── -->
			<section class="services-preview-section" aria-labelledby="section-capabilities-title">
				<div class="section-index-header">
					<span class="section-index-badge">§ III</span>
					<h2 class="section-index-title" id="section-capabilities-title">Capabilities · How I Help Teams Grow</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
					<a href="/services" class="section-index-link">Services &amp; engagement models →</a>
				</div>

				<div class="capabilities-grid">
					{
						capabilities.map((cap) => (
							<article class="capability-card">
								<div class="capability-header">
									<span class="capability-num">{cap.index}</span>
									<span class="capability-kicker">{cap.kicker}</span>
								</div>
								<h3 class="capability-title">{cap.title}</h3>
								<p class="capability-desc">{cap.description}</p>
								<div class="capability-foot">
									<span class="capability-deliverables">{cap.deliverables}</span>
								</div>
							</article>
						))
					}
				</div>
			</section>

			<!-- ── 6. § IV — Now & Direct Connect ── -->
			<section class="now-connect-section" aria-labelledby="section-now-title">
				<div class="section-index-header">
					<span class="section-index-badge">§ IV</span>
					<h2 class="section-index-title" id="section-now-title">Now · Current Focus &amp; Direct Channels</h2>
					<span class="section-index-rule" aria-hidden="true"></span>
					<a href="/ai-information" class="section-index-link">AI Fact Sheet →</a>
				</div>

				<div class="now-connect-grid">
					<div class="now-column">
						<span class="editorial-kicker">STATUS · Q4 2026</span>
						<h3 class="now-heading">Currently focused on</h3>
						<ul class="now-list">
							<li>
								<span class="now-arrow" aria-hidden="true">→</span>
								<div>
									<strong>GEO Citation Research &amp; Entity Engineering</strong> — Testing how ChatGPT, Claude, Perplexity, and Google AI Overviews retrieve, verify, and cite B2B &amp; e-commerce brands.
								</div>
							</li>
							<li>
								<span class="now-arrow" aria-hidden="true">→</span>
								<div>
									<strong>Senior SEO &amp; GEO Strategy at GTV SEO</strong> — Leading technical audits, semantic topical maps, and organic growth sprints across Vietnam, Australia, and global markets.
								</div>
							</li>
							<li>
								<span class="now-arrow" aria-hidden="true">→</span>
								<div>
									<strong>Open Playbooks &amp; Case Breakdowns</strong> — Documenting reproducible frameworks, schema patterns, and real campaign teardowns on this publication.
								</div>
							</li>
						</ul>
					</div>

					<div class="connect-column">
						<div class="connect-card">
							<span class="editorial-kicker">DIRECT CHANNELS</span>
							<h3 class="connect-heading">Start a conversation</h3>
							<p class="connect-desc">
								Available for select SEO &amp; GEO audits, technical architecture sprints, and advisory retainers. Typical response within 24 hours.
							</p>

							<dl class="connect-channels">
								<div class="connect-channel-row">
									<dt>Email</dt>
									<dd>
										<a href="mailto:tinledoihoa@gmail.com">tinledoihoa@gmail.com</a>
									</dd>
								</div>
								<div class="connect-channel-row">
									<dt>Phone / Zalo</dt>
									<dd>
										<a href="tel:+84357669476">0357.669.476</a>
									</dd>
								</div>
								<div class="connect-channel-row">
									<dt>LinkedIn</dt>
									<dd>
										<a
											href="https://www.linkedin.com/in/tin-le-hoang"
											target="_blank"
											rel="noopener noreferrer"
										>
											Tin Le Hoang ↗
										</a>
									</dd>
								</div>
							</dl>

							<div class="connect-actions">
								<a href="/contact" class="btn-primary connect-cta">
									Book a consultation →
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

		</div>
	</div>
</Base>

<style>
	/* ── Page Container ── */
	.home {
		max-width: var(--wide-width);
		margin: 0 auto;
	}

	/* ── 1. Hero Section ── */
	.hero {
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-16);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-masthead {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-10);
	}

	.vol-badge,
	.city-label {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
		white-space: nowrap;
	}

	.masthead-rule {
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		align-items: start;
		gap: var(--spacing-12);
	}

	.hero-text {
		min-width: 0;
	}

	.hero-name {
		font-family: var(--font-heading);
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		font-weight: 600;
		font-style: normal;
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.hero-positioning {
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 2.2vw, 1.625rem);
		font-weight: 500;
		line-height: 1.32;
		letter-spacing: -0.015em;
		color: var(--color-text);
		margin-bottom: var(--spacing-5);
		max-width: 54ch;
	}

	.hero-bio {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		margin-bottom: var(--spacing-8);
		max-width: 60ch;
	}

	.hero-ctas {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.hero-latest-row {
		margin-top: var(--spacing-5);
		padding-top: var(--spacing-4);
		border-top: 1px dashed var(--color-border);
		display: inline-block;
	}

	.hero-latest-link {
		display: inline-flex;
		align-items: baseline;
		gap: var(--spacing-2);
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		text-decoration: none;
		transition: color var(--transition-fast);
	}

	.hero-latest-prefix {
		color: var(--color-amber);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.hero-latest-title {
		color: var(--color-text);
		font-weight: 500;
		transition: color var(--transition-fast);
	}

	.hero-latest-link:hover .hero-latest-title {
		color: var(--color-accent);
	}

	/* ── Portrait Column ── */
	.hero-portrait {
		width: 100%;
	}

	.portrait-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-4);
		box-shadow: var(--shadow-tile-raised);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.portrait-frame {
		width: 100%;
		aspect-ratio: 1 / 1.05;
		border-radius: calc(var(--radius-lg) - 4px);
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-bg-subtle);
	}

	.portrait-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
	}

	.portrait-meta {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.portrait-caption {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.status-pill {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: 6px var(--spacing-3);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-secondary);
		line-height: 1.2;
	}

	.status-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #2e7d32;
		box-shadow: 0 0 0 3px color-mix(in srgb, #2e7d32 22%, transparent);
		flex-shrink: 0;
	}

	/* ── 2. Proof & Brand Strip ── */
	.proof-strip {
		padding: var(--spacing-10) var(--spacing-6);
		border-bottom: 1px solid var(--color-border);
		background: color-mix(in srgb, var(--color-bg-subtle) 55%, transparent);
	}

	.proof-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--spacing-4);
	}

	.proof-item {
		background: var(--color-surface);
