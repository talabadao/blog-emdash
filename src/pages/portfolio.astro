---
import Base from "../layouts/Base.astro";

const portfolioJsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	"@id": "https://tinlehoang.info.vn/portfolio#webpage",
	url: "https://tinlehoang.info.vn/portfolio",
	name: "SEO & GEO Growth Strategy Portfolio — Le Hoang Tin",
	description:
		"Visual strategy deck & campaign portfolio of Le Hoang Tin (Senior SEO & GEO Specialist, UEH International Business GPA 3.27/4.0, nearly 3 years at GTV SEO): Vinamilk (826K+ GSC clicks), IndochinaLight (+409% sales), Shadow Vietnam (+26.81% MoM revenue), EuroTravel (102.5K peak traffic), GTV SEO (#1 on ChatGPT/Grok/Claude), and Repair Centre VIC (Top 3-5 in 2 weeks).",
	mainEntity: {
		"@id": "https://tinlehoang.info.vn/#person",
	},
};

const agendaItems = [
	{
		num: "01",
		title: "Diagnostic & Entity Alignment",
		desc: "Technical crawlability, keyword cannibalization removal, duplicate content cleanup, and brand entity disambiguation.",
	},
	{
		num: "02",
		title: "Semantic & Technical Architecture",
		desc: "Topical Maps, keyword intent clustering, E-E-A-T content outlines, JSON-LD knowledge graphs, and /llms.txt endpoints.",
	},
	{
		num: "03",
		title: "Multi-Market Execution",
		desc: "High-velocity AI-assisted editorial workflows (40 articles/month), Cloud Stack, PR citations, and internal link equity.",
	},
	{
		num: "04",
		title: "Verified Proof Charts",
		desc: "Audited Google Search Console, Shopify Analytics, GA4, and Semrush screenshots across 6 flagship campaigns.",
	},
	{
		num: "05",
		title: "Scope of Work & Collaboration",
		desc: "Consulting engagement models, technical & GEO audits, monthly growth retainers, and full-time senior role readiness.",
	},
];

const processStages = [
	{
		step: "01",
		title: "Technical & Entity Audit",
		tools: "Screaming Frog · GSC · Log & Crawl Analysis",
		points: [
			"Audit index bloat, crawl budget waste, and Core Web Vitals",
			"Identify and consolidate Keyword Cannibalization & Duplicate Content",
			"Map commercial entity gaps against local & global competitors",
		],
		icon: "audit",
	},
	{
		step: "02",
		title: "Topical Map & AI Search Prep",
		tools: "Semrush · Ahrefs · JSON-LD · /llms.txt",
		points: [
			"Group high-intent keywords into pillar-cluster Topical Maps",
			"Engineer structured E-E-A-T content outlines & Onpage checklists",
			"Deploy Person/Organization/Service Schema & AI crawler manifests",
		],
		icon: "map",
	},
	{
		step: "03",
		title: "High-Velocity Content & Authority",
		tools: "ChatGPT / Claude / Perplexity APIs · White Hat PR",
		points: [
			"Scale up to 40 SEO-standard, fact-dense articles/month with AI APIs",
			"Build balanced internal linking hubs to commercial money pages",
			"Execute 100% White Hat Cloud Stack, Guest Posts, and PR citations",
		],
		icon: "velocity",
	},
	{
		step: "04",
		title: "GA4 CRO & Revenue Scaling",
		tools: "GA4 · Google Tag Manager · Shopify Analytics",
		points: [
			"Optimize Product Page Views, Time Onsite, and UI/UX conversion paths",
			"Track organic orders, B2B lead forms, and phone/Zalo conversions",
			"Iterate quarterly audits to sustain 100%–120% SEO KPI delivery",
		],
		icon: "cro",
	},
];
---

<Base
	title="Visual Portfolio Deck — Le Hoang Tin | Senior SEO & GEO Specialist"
	description="Executive SEO & GEO Growth Strategy Portfolio of Le Hoang Tin (Senior SEO & GEO Specialist, UEH International Business GPA 3.27/4.0). Explore 10 visual strategy slides and verified GSC, GA4, Shopify & Semrush proof charts across 6 flagship campaigns."
	jsonLd={portfolioJsonLd}
>
	<div class="portfolio-deck-page">
		<!-- Sticky Top Deck Controls Bar -->
		<div class="deck-controls-bar no-print" aria-label="Presentation deck controls">
			<div class="deck-controls-left">
				<p class="editorial-kicker">VISUAL PORTFOLIO &amp; STRATEGY DECK · 2022–2026</p>
				<nav class="deck-quick-nav" aria-label="Slide jump navigation">
					<a href="#slide-cover" class="deck-pill">01 Cover</a>
					<a href="#slide-overview" class="deck-pill">02 Overview</a>
					<a href="#slide-process" class="deck-pill">03 Process</a>
					<a href="#slide-vinamilk" class="deck-pill">04 Case Visuals</a>
					<a href="#slide-collab" class="deck-pill">05 Scope &amp; Collab</a>
				</nav>
			</div>
			<div class="deck-controls-right">
				<button type="button" id="print-deck-btn" class="deck-action-btn">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M6 9V2h12v7"></path>
						<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
						<rect x="6" y="14" width="12" height="8"></rect>
					</svg>
					<span>Print / Save as PDF Deck</span>
				</button>
				<button type="button" id="copy-deck-link-btn" class="deck-action-btn">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
						<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
					</svg>
					<span id="copy-deck-link-label">Copy Portfolio Link</span>
				</button>
				<a href="/#get-in-touch" class="deck-cta-btn">Get in Touch →</a>
			</div>
		</div>

		<!-- ============================================================
		     SLIDE 01 — EXECUTIVE COVER SLIDE
		     ============================================================ -->
		<section id="slide-cover" class="deck-slide cover-slide">
			<div class="slide-topbar cover-topbar">
				<span class="slide-num">SLIDE 01 / 10 · EXECUTIVE STRATEGY DECK</span>
				<span class="slide-domain">TINLEHOANG.INFO.VN/PORTFOLIO</span>
			</div>

			<div class="cover-grid">
				<div class="cover-main">
					<div class="cover-eyebrow-pill">
						<span class="cover-dot" aria-hidden="true"></span>
						<span>VERIFIED CAMPAIGN PORTFOLIO · GOOGLE &amp; AI SEARCH (GEO)</span>
					</div>
					<h1 class="cover-title">SEO &amp; GEO GROWTH STRATEGY PORTFOLIO</h1>
					<p class="cover-subtitle">
						Optimizing Organic Revenue, High-Intent Traffic &amp; AI Search Citations Through Data-Driven Insights.
					</p>

					<div class="cover-highlights-strip">
						<div class="cover-highlight-item">
							<span class="cover-hi-val">6 Flagship Campaigns</span>
							<span class="cover-hi-lbl">Lead &amp; Primary Implementer / Advisor</span>
						</div>
						<div class="cover-highlight-item">
							<span class="cover-hi-val">100%–120% KPIs</span>
							<span class="cover-hi-lbl">Delivered Across VN, US, AU, SG, IT &amp; EU</span>
						</div>
						<div class="cover-highlight-item">
							<span class="cover-hi-val">#1 AI Citations</span>
							<span class="cover-hi-lbl">ChatGPT, Claude &amp; Grok Recommendations</span>
						</div>
					</div>
				</div>

				<aside class="cover-presenter-card">
					<div class="presenter-header">
						<img
							src="/tin_le_hoang.jpg"
							alt="Le Hoang Tin — Senior SEO & GEO Specialist"
							class="presenter-avatar"
							width="88"
							height="88"
						/>
						<div>
							<p class="presenter-kicker">PRESENTED BY</p>
							<h2 class="presenter-name">Le Hoang Tin</h2>
							<p class="presenter-role">Senior SEO &amp; GEO Specialist</p>
						</div>
					</div>

					<dl class="presenter-facts">
						<div class="presenter-fact-row">
							<dt>Experience</dt>
							<dd>Nearly 3 Years Leading Campaigns at <strong>GTV SEO</strong> (Nov 2022 – Apr 2025)</dd>
						</div>
						<div class="presenter-fact-row">
							<dt>Education</dt>
							<dd><strong>UEH</strong> — International Business · <strong>GPA 3.27/4.0</strong></dd>
						</div>
						<div class="presenter-fact-row">
							<dt>Phone / Zalo</dt>
							<dd><a href="tel:+84357669476">0357.669.476</a></dd>
						</div>
						<div class="presenter-fact-row">
							<dt>Direct Email</dt>
							<dd><a href="mailto:tinledoihoa@gmail.com">tinledoihoa@gmail.com</a></dd>
						</div>
						<div class="presenter-fact-row">
							<dt>LinkedIn</dt>
							<dd><a href="https://www.linkedin.com/in/tin-le-hoang" target="_blank" rel="noopener noreferrer">linkedin.com/in/tin-le-hoang ↗</a></dd>
						</div>
					</dl>
				</aside>
			</div>
		</section>

		<!-- ============================================================
		     SLIDE 02 — EXECUTIVE AGENDA & PROFILE MATRIX
		     ============================================================ -->
		<section id="slide-overview" class="deck-slide">
			<div class="slide-topbar">
				<span class="slide-num">SLIDE 02 / 10 · EXECUTIVE OVERVIEW &amp; AGENDA</span>
				<span class="slide-domain">WHO I AM &amp; TRACK RECORD</span>
			</div>

			<div class="overview-grid">
				<!-- Left: AGENDA 01-05 -->
				<div class="agenda-panel">
					<p class="panel-kicker">PRESENTATION AGENDA</p>
					<h2 class="panel-title">01–05 Strategic Roadmap</h2>
					<ol class="agenda-list">
						{
							agendaItems.map((item) => (
								<li class="agenda-row">
									<span class="agenda-num">{item.num}</span>
									<div class="agenda-body">
										<h3>{item.title}</h3>
										<p>{item.desc}</p>
									</div>
								</li>
							))
						}
					</ol>
				</div>

				<!-- Right: WHO I AM & TRACK RECORD -->
				<div class="profile-matrix-panel">
					<p class="panel-kicker">WHO I AM &amp; TRACK RECORD</p>
					<h2 class="panel-title">Data-Driven SEO &amp; GEO Specialist</h2>
					<p class="profile-summary-copy">
						With nearly <strong>3 years of experience</strong> leading SEO projects at <strong>GTV SEO</strong> across healthcare/nutrition, e-commerce, tourism, B2B agency, and local services — from Vietnamese businesses to global enterprises — I specialize in data-driven SEO strategies aligned with marketing objectives, Conversion Rate Optimization (CRO), and R&amp;D on user search intent across Google and AI-driven channels (ChatGPT, Claude, Perplexity, Grok). Graduated in <strong>International Business</strong> from the <strong>University of Economics Ho Chi Minh City (UEH — GPA 3.27/4.0)</strong>.
					</p>

					<!-- 4 Quadrant KPI Highlights -->
					<div class="quadrant-kpis">
						<div class="quad-card">
							<span class="quad-val">826K+</span>
							<span class="quad-lbl">Vinamilk GSC Clicks</span>
							<span class="quad-sub">300K clicks/mo · 15.9M impressions · 100% KPI in 5 mos</span>
						</div>
						<div class="quad-card">
							<span class="quad-val">#1</span>
							<span class="quad-lbl">ChatGPT / Grok / Claude</span>
							<span class="quad-sub">Top 1 AI recommendation for &ldquo;seo agency hcm&rdquo; at GTV SEO</span>
						</div>
						<div class="quad-card">
							<span class="quad-val">102.5K</span>
							<span class="quad-lbl">EuroTravel Peak Traffic</span>
							<span class="quad-sub">80K GSC clicks/mo · 120% TOP KPI target in 6 months</span>
						</div>
						<div class="quad-card">
							<span class="quad-val">+409%</span>
							<span class="quad-lbl">IndochinaLight Sales</span>
							<span class="quad-sub">$7,504.98 organic sales · +280% orders · Top 10 US/AU/SG/IT</span>
						</div>
					</div>

					<!-- 3 GTV SEO Achievements -->
					<div class="achievements-strip">
						<h3 class="achievements-heading">Key Honors &amp; Internal Impact at GTV SEO</h3>
						<ul class="achievements-list">
							<li>
								<span class="ach-tag">AWARD</span>
								<span><strong>3rd Prize</strong> in the <strong>AI Application for SEO</strong> competition organized internally by GTV SEO</span>
							</li>
							<li>
								<span class="ach-tag">AUTHOR</span>
								<span><strong>Author of documents &amp; e-books</strong> for GTV SEO courses and internal training materials</span>
							</li>
							<li>
								<span class="ach-tag">STRATEGIST</span>
								<span><strong>Planner for 10+ projects</strong> helping GTV SEO bid and win new clients successfully (Local &amp; Global)</span>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     SLIDE 03 — HOW IT WORKS: 4-STAGE SEO & GEO EXECUTION SYSTEM
		     ============================================================ -->
		<section id="slide-process" class="deck-slide">
			<div class="slide-topbar">
				<span class="slide-num">SLIDE 03 / 10 · METHODOLOGY &amp; WORKFLOW</span>
				<span class="slide-domain">4-STAGE SEO &amp; GEO EXECUTION SYSTEM</span>
			</div>

			<div class="slide-header-block">
				<div>
					<p class="panel-kicker">HOW IT WORKS</p>
					<h2 class="slide-main-heading">4-Stage Full-Funnel SEO &amp; GEO Execution System</h2>
				</div>
				<p class="slide-header-sub">
					Every campaign follows a disciplined diagnostic-to-revenue engineering loop combining technical precision, semantic entity architecture, AI-assisted content scale, and GA4 conversion attribution.
				</p>
			</div>

			<div class="process-columns">
				{
					processStages.map((stage) => (
						<article class="process-col-card">
							<div class="process-col-top">
								<span class="process-step-badge">STAGE {stage.step}</span>
								<div class="process-icon-box" aria-hidden="true">
									{stage.icon === "audit" && (
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
											<circle cx="11" cy="11" r="8"></circle>
											<path d="m21 21-4.3-4.3"></path>
											<path d="M8 11h6"></path>
											<path d="M11 8v6"></path>
										</svg>
									)}
									{stage.icon === "map" && (
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
											<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
											<line x1="9" y1="3" x2="9" y2="18"></line>
											<line x1="15" y1="6" x2="15" y2="21"></line>
										</svg>
									)}
									{stage.icon === "velocity" && (
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
											<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"></path>
										</svg>
									)}
									{stage.icon === "cro" && (
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
											<path d="M3 3v18h18"></path>
											<path d="m19 9-5 5-4-4-3 3"></path>
										</svg>
									)}
								</div>
							</div>
							<h3 class="process-col-title">{stage.step}. {stage.title}</h3>
							<p class="process-col-tools">{stage.tools}</p>
							<ul class="process-col-points">
								{stage.points.map((pt) => (
									<li>{pt}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<!-- ============================================================
		     SLIDE 04 — CAMPAIGN 01: VINAMILK (826K+ GSC CLICKS)
		     ============================================================ -->
		<section id="slide-vinamilk" class="deck-slide campaign-slide">
			<div class="slide-topbar">
				<span class="slide-num">SLIDE 04 / 10 · CAMPAIGN CASE STUDY 01</span>
				<span class="slide-domain">VINAMILK.COM.VN · NOV 2023 – MAR 2024 (5 MOS)</span>
			</div>

			<div class="campaign-grid">
				<!-- Left: Visual Proof Showcase -->
				<div class="proof-showcase-col">
					<div class="browser-frame">
						<div class="browser-bar">
							<div class="browser-dots" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
							<span class="browser-url">search.google.com/search-console · vinamilk.com.vn (Verified GSC)</span>
							<span class="browser-badge">LIVE PROOF</span>
						</div>
						<button
							type="button"
							class="proof-zoom-trigger"
							data-lightbox-src="/proof/vinamilk-gsc-826k-clicks.png"
							data-lightbox-caption="Vinamilk (vinamilk.com.vn) — Google Search Console Performance: 826,000+ Total Clicks, 15.9M Impressions, 300,000 Clicks/Month & 100% SEO KPIs in 5 Months"
							aria-label="Zoom Vinamilk Google Search Console proof chart"
						>
							<img
								src="/proof/vinamilk-gsc-826k-clicks.png"
								alt="Vinamilk Google Search Console chart showing 826K+ total clicks and 15.9M impressions"
								loading="lazy"
							/>
							<span class="zoom-overlay-pill no-print">Click to Zoom Full Chart ↗</span>
						</button>
					</div>
					<p class="proof-caption">
						<strong>Figure 01:</strong> Google Search Console performance verification for <code>vinamilk.com.vn</code> — scaling organic clicks to <strong>300,000 clicks/month</strong> (<code>826K+ total clicks</code>, <code>15.9M impressions</code>).
					</p>
				</div>

				<!-- Right: Executive Breakdown -->
				<div class="exec-breakdown-col">
					<div class="campaign-meta-row">
						<span class="campaign-industry-pill">Vietnam Enterprise Nutrition &amp; FMCG</span>
						<span class="campaign-role-pill">Lead &amp; Primary Implementer (SEO Specialist)</span>
					</div>
					<div class="campaign-title-bar">
						<h2 class="campaign-title">01. Vinamilk | Nutrition E-Commerce Project</h2>
						<span class="campaign-logo-badge">
							<img src="/logos/vinamilk.png" alt="Vinamilk logo" class="campaign-logo-img" width="120" height="48" loading="lazy" />
						</span>
					</div>

					<div class="campaign-kpi-tiles">
						<div class="kpi-tile">
							<span class="kpi-tile-val">300,000</span>
							<span class="kpi-tile-lbl">GSC Clicks / Month</span>
						</div>
						<div class="kpi-tile">
							<span class="kpi-tile-val">826K+</span>
							<span class="kpi-tile-lbl">Total GSC Clicks (15.9M Impr.)</span>
						</div>
						<div class="kpi-tile">
							<span class="kpi-tile-val">100% KPI</span>
							<span class="kpi-tile-lbl">Achieved After 5 Months</span>
						</div>
					</div>

					<div class="breakdown-boxes">
						<div class="breakdown-box">
							<h3>Project Scope &amp; Task Executed</h3>
							<p>
								Served as <strong>Lead &amp; Primary Implementer (SEO Specialist)</strong> from <code>Nov 2023 – Mar 2024 (5 mos)</code> on <code>vinamilk.com.vn</code>. Executed comprehensive Technical Audit, UI-UX optimization, Keyword grouping, Topical Map architecture, Content Outlines, and Onpage Checklist across nutrition and product hubs.
							</p>
						</div>
						<div class="breakdown-box highlight-box">
							<h3>Verified Traffic, Ranking &amp; Conversion Results</h3>
							<ul>
								<li>Reached <strong>300,000 clicks/month (GSC)</strong> and <strong>320,000 monthly traffic</strong> (<code>826,000+ total clicks</code> &amp; <code>15.9M impressions</code> in GSC).</li>
								<li>Hit <strong>100% of SEO KPIs after 5 months</strong> of disciplined technical &amp; semantic execution.</li>
								<li>Achieved <strong>Top 1–3 rankings</strong> for high-volume keywords related to nutritional products, mom &amp; baby nutrition, baby cereal, baby milk, and recipes.</li>
							</ul>
						</div>
					</div>

					<div class="campaign-footer-links no-print">
						<a href="/posts/scaling-vinamilk-to-300k-monthly-organic-clicks" class="campaign-link-btn">Read Full Vinamilk Case Study →</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================
		     SLIDE 05 — CAMPAIGN 02: INDOCHINALIGHT (+409% SALES GROWTH)
		     ============================================================ -->
		<section id="slide-indochinalight" class="deck-slide campaign-slide">
			<div class="slide-topbar">
				<span class="slide-num">SLIDE 05 / 10 · CAMPAIGN CASE STUDY 02</span>
				<span class="slide-domain">INDOCHINALIGHT · NOV 2024 – APR 2025 (6 MOS)</span>
			</div>

			<div class="campaign-grid">
				<!-- Left: Visual Proof Showcase -->
				<div class="proof-showcase-col">
					<div class="browser-frame">
						<div class="browser-bar">
							<div class="browser-dots" aria-hidden="true">
								<span></span><span></span><span></span>
							</div>
							<span class="browser-url">admin.shopify.com/analytics · IndochinaLight Global Store</span>
							<span class="browser-badge">SHOPIFY VERIFIED</span>
						</div>
						<button
							type="button"
							class="proof-zoom-trigger"
							data-lightbox-src="/proof/furniture-shopify-conversions.png"
							data-lightbox-caption="IndochinaLight Global Dropshipping E-Commerce — Shopify Verified Analytics: $7,504.98 Total Sales (+409%), 19 Orders (+280%), 6,310 Sessions (+23%), Conversion Rate +176%"
							aria-label="Zoom IndochinaLight Shopify revenue and conversion chart"
						>
							<img
								src="/proof/furniture-shopify-conversions.png"
								alt="IndochinaLight Shopify Analytics showing $7,504.98 total sales (+409%) and 19 organic orders (+280%)"
								loading="lazy"
							/>
							<span class="zoom-overlay-pill no-print">Click to Zoom Full Chart ↗</span>
						</button>
					</div>
					<p class="proof-caption">
						<strong>Figure 02:</strong> Shopify Analytics dashboard for IndochinaLight showing <strong>$7,504.98 total sales (+409%)</strong>, <strong>19 orders (+280%)</strong>, and <strong>+176% conversion rate</strong> on a brand-new domain.
					</p>
				</div>

				<!-- Right: Executive Breakdown -->
				<div class="exec-breakdown-col">
					<div class="campaign-meta-row">
						<span class="campaign-industry-pill">Global Dropshipping (US, SG, IT, AU) · Furniture &amp; Lighting</span>
						<span class="campaign-role-pill">Lead &amp; Primary Implementer (SEO Specialist)</span>
					</div>
					<div class="campaign-title-bar">
						<h2 class="campaign-title">02. IndochinaLight | Global Dropshipping E-Commerce</h2>
						<span class="campaign-logo-badge">
							<img src="/logos/indochinalight.png" alt="IndochinaLight logo" class="campaign-logo-img" width="120" height="48" loading="lazy" />
						</span>
					</div>

					<div class="campaign-kpi-tiles">
