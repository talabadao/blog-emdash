<script is:inline>
	(function () {
		// Print / Save as PDF Deck button
		var printBtn = document.getElementById("print-deck-btn");
		if (printBtn) {
			printBtn.addEventListener("click", function () {
				window.print();
			});
		}

		// Copy Portfolio Link button
		var copyBtn = document.getElementById("copy-deck-link-btn");
		var copyLabel = document.getElementById("copy-deck-link-label");
		if (copyBtn && copyLabel) {
			copyBtn.addEventListener("click", function () {
				var url = window.location.origin + "/portfolio";
				if (navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(url).then(function () {
						copyLabel.textContent = "Copied URL!";
						setTimeout(function () {
							copyLabel.textContent = "Copy Portfolio Link";
						}, 2200);
					});
				}
			});
		}

		// Click-to-Zoom Lightbox Modal
		var dialog = document.getElementById("portfolio-lightbox");
		var lightboxImg = document.getElementById("lightbox-img");
		var lightboxCaption = document.getElementById("lightbox-caption");
		var closeBtn = document.getElementById("lightbox-close-btn");
		var triggers = document.querySelectorAll(".proof-zoom-trigger");

		triggers.forEach(function (btn) {
			btn.addEventListener("click", function () {
				var src = btn.getAttribute("data-lightbox-src");
				var cap = btn.getAttribute("data-lightbox-caption");
				if (dialog && lightboxImg && src) {
					lightboxImg.setAttribute("src", src);
					if (lightboxCaption && cap) {
						lightboxCaption.textContent = cap;
					}
					if (typeof dialog.showModal === "function") {
						dialog.showModal();
					} else {
						dialog.setAttribute("open", "true");
					}
				}
			});
		});

		if (closeBtn && dialog) {
			closeBtn.addEventListener("click", function () {
				if (typeof dialog.close === "function") {
					dialog.close();
				} else {
					dialog.removeAttribute("open");
				}
			});
		}

		if (dialog) {
			dialog.addEventListener("click", function (e) {
				if (e.target === dialog) {
					if (typeof dialog.close === "function") {
						dialog.close();
					} else {
						dialog.removeAttribute("open");
					}
				}
			});
		}
	})();
</script>

