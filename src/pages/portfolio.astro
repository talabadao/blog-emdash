		color: var(--color-accent);
		letter-spacing: 0.06em;
	}

	.process-icon-box {
		width: 38px;
		height: 38px;
		border-radius: 10px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
	}

	.process-col-title {
		font-family: var(--font-heading);
		font-size: 1.02rem;
		font-weight: 600;
		margin: 0;
		color: var(--color-text);
	}

	.process-col-tools {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-primary);
		margin: 0;
	}

	.process-col-points {
		margin: 0;
		padding-left: 1.1rem;
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--color-text-muted);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	/* Slides 04-09: Campaign Showcase Slides */
	.campaign-grid {
		display: grid;
		grid-template-columns: 1.12fr 1fr;
		gap: 2rem;
		align-items: start;
	}

	.proof-showcase-col {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.dual-proof-stack {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.browser-frame {
		border: 1px solid var(--color-border);
		border-radius: 12px;
		overflow: hidden;
		background: var(--color-bg);
	}

	.browser-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		padding: 0.55rem 0.85rem;
		background: var(--color-bg-subtle);
		border-bottom: 1px solid var(--color-border);
	}

	.browser-dots {
		display: flex;
		gap: 5px;
	}

	.browser-dots span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-border);
	}

	.browser-url {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.browser-badge {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
		background: var(--color-primary);
		color: #ffffff;
		flex-shrink: 0;
	}

	.proof-zoom-trigger {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: #ffffff;
		cursor: zoom-in;
		text-align: left;
	}

	.proof-zoom-trigger img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 360px;
		object-fit: contain;
		background: #ffffff;
	}

	.dual-proof-stack .proof-zoom-trigger img {
		max-height: 205px;
	}

	.zoom-overlay-pill {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		background: rgba(26, 46, 26, 0.88);
		color: #ffffff;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		transition: transform 0.15s ease;
	}

	.proof-zoom-trigger:hover .zoom-overlay-pill {
		transform: scale(1.04);
		background: var(--color-accent);
	}

	.proof-caption {
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Graphic SERP & AI Citation Boards (Slides 08 & 09) */
	.serp-board-body {
		padding: 1.15rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		background: var(--color-surface);
	}

	.ai-citation-banner {
		padding: 0.95rem 1rem;
		border-radius: 10px;
		background: linear-gradient(135deg, #1a2e1a 0%, #2d4a2d 100%);
		color: #f5f0e6;
	}

	.ai-citation-header {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-bottom: 0.65rem;
	}

	.ai-live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #e8772a;
	}

	.ai-citation-kicker {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		color: rgba(245, 240, 230, 0.85);
	}

	.ai-engines-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.6rem;
	}

	.ai-engine-card {
		padding: 0.6rem 0.7rem;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.15);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.ai-engine-name {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: rgba(245, 240, 230, 0.75);
	}

	.ai-engine-rank {
		font-family: var(--font-heading);
		font-size: 0.88rem;
		font-weight: 600;
		color: #f08a3e;
	}

	.ai-engine-query {
		font-size: 0.7rem;
		color: #ffffff;
	}

	.serp-table-wrapper {
		border: 1px solid var(--color-border);
		border-radius: 10px;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		max-width: 100%;
	}

	.serp-table-title {
		display: flex;
		justify-content: space-between;
		padding: 0.55rem 0.85rem;
		background: var(--color-bg-subtle);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-text);
		min-width: 520px;
	}

	.serp-ranking-table {
		width: 100%;
		min-width: 520px;
		border-collapse: collapse;
		font-size: 0.78rem;
	}

	.serp-ranking-table th,
	.serp-ranking-table td {
		padding: 0.5rem 0.75rem;
		border-top: 1px solid var(--color-border);
		text-align: left;
	}

	.serp-ranking-table th {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		text-transform: uppercase;
		color: var(--color-text-muted);
		background: var(--color-bg);
	}

	.rank-pill {
		display: inline-block;
		padding: 0.15rem 0.5rem;
		border-radius: 9999px;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
	}

	.rank-top1 {
		background: rgba(45, 74, 45, 0.14);
		color: var(--color-primary);
	}

	.rank-top5 {
		background: rgba(232, 119, 42, 0.15);
		color: var(--color-accent);
	}

	/* Slide 09 Turnaround KPI Bars */
	.turnaround-header-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 10px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.turnaround-kicker {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: var(--color-accent);
		margin: 0 0 0.2rem;
	}

	.turnaround-heading {
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 600;
		margin: 0;
		color: var(--color-text);
	}

	.turnaround-badge {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.3rem 0.65rem;
		border-radius: 9999px;
		background: var(--color-accent);
		color: #ffffff;
		flex-shrink: 0;
	}

	.kpi-bars-container {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.kpi-bar-row {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.kpi-bar-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.78rem;
	}

	.kpi-bar-track {
		height: 10px;
		border-radius: 9999px;
		background: var(--color-bg-subtle);
		overflow: hidden;
	}

	.kpi-bar-fill {
		height: 100%;
		border-radius: 9999px;
		background: var(--color-primary);
	}

	.kpi-bar-accent {
		background: var(--color-accent);
	}

	.aus-keywords-box {
		padding: 0.75rem 0.9rem;
		border-radius: 10px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.aus-kw-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.aus-kw-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.aus-kw-chips code {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		word-break: break-word;
		white-space: normal;
	}

	/* Executive Breakdown Right Column */
	.exec-breakdown-col {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.campaign-meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.campaign-industry-pill,
	.campaign-role-pill {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		padding: 0.22rem 0.65rem;
		border-radius: 9999px;
	}

	.campaign-industry-pill {
		background: var(--color-bg-subtle);
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
	}

	.campaign-role-pill {
		background: rgba(45, 74, 45, 0.12);
		color: var(--color-primary);
	}

	.campaign-title-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.campaign-logo-badge {
		width: 120px;
		height: 48px;
		border-radius: 8px;
		border: 1px solid var(--color-border);
		background: #ffffff;
		overflow: hidden;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
	}

	.campaign-logo-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.campaign-title {
		font-family: var(--font-heading);
		font-size: 1.45rem;
		font-weight: 500;
		line-height: 1.2;
		margin: 0;
		color: var(--color-text);
	}

	.campaign-kpi-tiles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.65rem;
	}

	.kpi-tile {
		padding: 0.75rem 0.85rem;
		border-radius: 10px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.kpi-tile-val {
		font-family: var(--font-heading);
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--color-accent);
	}

	.kpi-tile-lbl {
		font-size: 0.73rem;
		color: var(--color-text-muted);
		line-height: 1.3;
	}

	.breakdown-boxes {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.breakdown-box {
		padding: 0.95rem 1.1rem;
		border-radius: 10px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.breakdown-box.highlight-box {
		background: var(--color-bg-subtle);
		border-left: 3px solid var(--color-primary);
	}

	.breakdown-box h3 {
		font-family: var(--font-mono);
		font-size: 0.73rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary);
		margin: 0 0 0.45rem;
	}

	.breakdown-box p {
		font-size: 0.85rem;
		line-height: 1.55;
		color: var(--color-text);
		margin: 0;
	}

	.breakdown-box ul {
		margin: 0;
		padding-left: 1.1rem;
		font-size: 0.84rem;
		line-height: 1.55;
		color: var(--color-text);
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.campaign-link-btn {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-heading);
		font-size: 0.84rem;
		font-weight: 600;
		color: var(--color-accent);
		text-decoration: none;
	}

	.campaign-link-btn:hover {
		text-decoration: underline;
	}

	/* Slide 10: Collab Slide */
	.collab-header {
		max-width: 68ch;
		margin-bottom: 1.75rem;
	}

	.collab-kicker {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		color: #f08a3e;
		margin: 0 0 0.4rem;
	}

	.collab-title {
		font-family: var(--font-heading);
		font-size: clamp(1.75rem, 3vw, 2.4rem);
		font-weight: 500;
		color: #ffffff;
		margin: 0 0 0.65rem;
	}

	.collab-sub {
		font-size: 0.98rem;
		line-height: 1.55;
		color: rgba(245, 240, 230, 0.85);
		margin: 0;
	}

	.collab-tiers-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin-bottom: 1.75rem;
	}

	.collab-tier-card {
		padding: 1.25rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(245, 240, 230, 0.16);
	}

	.collab-tier-featured {
		background: rgba(232, 119, 42, 0.14);
		border-color: #f08a3e;
	}

	.collab-tier-num {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		color: #f08a3e;
	}

	.collab-tier-card h3 {
		font-family: var(--font-heading);
		font-size: 1.08rem;
		font-weight: 500;
		color: #ffffff;
		margin: 0.35rem 0 0.5rem;
	}

	.collab-tier-card p {
		font-size: 0.84rem;
		line-height: 1.5;
		color: rgba(245, 240, 230, 0.84);
		margin: 0;
	}

	.collab-contact-strip {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgba(245, 240, 230, 0.16);
	}

	.collab-direct-info {
		display: flex;
		flex-wrap: wrap;
		gap: 1.75rem;
	}

	.collab-info-lbl {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: rgba(245, 240, 230, 0.65);
		margin-bottom: 0.15rem;
	}

	.collab-info-val {
		font-family: var(--font-heading);
		font-size: 0.92rem;
		font-weight: 500;
		color: #ffffff;
		text-decoration: none;
	}

	.collab-cta-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.collab-primary-btn {
		padding: 0.65rem 1.25rem;
		border-radius: 9999px;
		background: #e8772a;
		color: #ffffff;
		font-family: var(--font-heading);
		font-size: 0.86rem;
		font-weight: 600;
		text-decoration: none;
	}

	.collab-secondary-btn {
		padding: 0.65rem 1.15rem;
		border-radius: 9999px;
		border: 1px solid rgba(245, 240, 230, 0.3);
		color: #f5f0e6;
		font-family: var(--font-heading);
		font-size: 0.84rem;
		font-weight: 500;
		text-decoration: none;
	}

	/* Lightbox Modal */
	.proof-lightbox {
		max-width: 92vw;
		max-height: 90vh;
		width: 1080px;
		border: 1px solid var(--color-border);
		border-radius: 14px;
		padding: 0;
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
	}

	.proof-lightbox::backdrop {
		background: rgba(15, 25, 15, 0.78);
		backdrop-filter: blur(4px);
	}

	.lightbox-inner {
		display: flex;
		flex-direction: column;
	}

	.lightbox-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.25rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
	}

	.lightbox-caption {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
	}

	.lightbox-close-btn {
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		cursor: pointer;
	}

	.lightbox-img-wrap {
		padding: 1rem;
		background: #ffffff;
		overflow: auto;
		max-height: 78vh;
	}

	.lightbox-img-wrap img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Responsive Breakpoints */
	@media (max-width: 980px) {
		.cover-grid,
		.overview-grid,
		.campaign-grid {
			grid-template-columns: 1fr;
		}

		.process-columns {
			grid-template-columns: repeat(2, 1fr);
		}

		.collab-tiers-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.portfolio-deck-page {
			padding: 0.85rem 0.75rem 3rem;
			gap: 1.5rem;
		}

		.deck-controls-bar {
			top: 0.5rem;
			padding: 0.55rem 0.75rem;
			gap: 0.45rem;
		}

		.deck-controls-left {
			width: 100%;
			gap: 0.35rem;
		}

		.deck-controls-left .editorial-kicker {
			display: none;
		}

		.deck-quick-nav {
			width: 100%;
			flex-wrap: nowrap;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			padding-bottom: 2px;
		}

		.deck-quick-nav::-webkit-scrollbar {
			display: none;
		}

		.deck-pill {
			white-space: nowrap;
			flex-shrink: 0;
		}

		.deck-controls-right {
			width: 100%;
			justify-content: flex-end;
			gap: 0.4rem;
		}

		#print-deck-btn {
			display: none;
		}

		.deck-action-btn,
		.deck-cta-btn {
			font-size: 0.74rem;
			padding: 0.38rem 0.75rem;
		}
	}

	@media (max-width: 640px) {
		.deck-slide {
			padding: 1.25rem 1rem;
			border-radius: 12px;
		}

		.campaign-title-bar {
			flex-direction: column-reverse;
			align-items: flex-start;
			gap: 0.65rem;
		}

		.campaign-logo-badge {
			width: 110px;
			height: 44px;
		}

		.campaign-title {
			font-size: 1.25rem;
		}

		.cover-highlights-strip,
		.quadrant-kpis,
		.process-columns,
		.campaign-kpi-tiles,
		.ai-engines-grid {
			grid-template-columns: 1fr;
		}

		.collab-direct-info {
			flex-direction: column;
			gap: 0.85rem;
		}

		.collab-cta-buttons {
			flex-direction: column;
			width: 100%;
		}

		.collab-primary-btn,
		.collab-secondary-btn {
			width: 100%;
			text-align: center;
			justify-content: center;
		}
	}

	@media (max-width: 480px) {
		.presenter-fact-row {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}

	/* Clean Print / Save as PDF Deck Rules */
	@media print {
		.no-print {
			display: none !important;
		}

		.portfolio-deck-page {
			max-width: 100%;
			padding: 0;
			gap: 1.25rem;
		}

		.deck-slide {
			break-inside: avoid;
			page-break-inside: avoid;
			box-shadow: none;
			border: 1px solid #cccccc;
		}
