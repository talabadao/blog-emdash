	},
	{
		id: "vinamilk",
		number: "03",
		name: "Vinamilk Nutrition",
		domain: "vinamilk.com.vn",
		domainUrl: "https://www.vinamilk.com.vn",
		timeline: "Nov 2023 – Mar 2024",
		industry: "Enterprise FMCG & E-Commerce",
		market: "VN",
		categories: ["ecommerce"],
		role: "Lead Implementer",
		metrics: [
			{ value: "300K+", label: "Monthly Organic Clicks" },
			{ value: "Top 1–3", label: "Maternal & Baby Terms" },
			{ value: "100%", label: "Committed KPI Achieved" },
		],
		challenge:
			"Fragmented informational content and strict YMYL nutritional quality standards limited organic capture in Vietnam's hyper-competitive maternal and infant nutrition vertical.",
		strategy:
			"Built a full-funnel semantic topical map, authored E-E-A-T aligned editorial outlines, and enforced rigorous on-page technical checklists and hub-and-spoke internal linking across the nutrition hub.",
		outcome:
