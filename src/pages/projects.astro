		border: 1px solid var(--color-border-subtle);
		border-radius: calc(var(--radius-lg) - 4px);
	}

	.kpi-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.kpi-value {
		font-family: var(--font-mono);
		font-size: var(--font-size-lg);
		font-weight: 600;
		line-height: 1.15;
		color: var(--color-accent);
	}

	.kpi-label {
