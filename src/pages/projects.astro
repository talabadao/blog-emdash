---

<Base
	title="Projects & Verifiable SEO/GEO Results"
	description="6 flagship organic growth and AI search (GEO) engagements by Le Hoang Tin across Vietnam, Australia, and global English markets — backed by Search Console, GA4, and AI citation metrics."
>
	<div class="projects-page">
		<!-- ── Page Header ── -->
		<header class="page-header">
			<span class="editorial-kicker">CASE STUDIES &amp; CAMPAIGN ARCHIVE</span>
			<h1 class="page-title">Projects &amp; Verifiable SEO/GEO Results</h1>
			<p class="page-lead">
				6 flagship organic growth and AI search (GEO) engagements across Vietnam, Australia, and global English markets — backed by real Search Console, GA4, and AI citation metrics.
			</p>
		</header>

		<!-- ── Summary Proof Bar ── -->
		<section class="summary-proof-bar" aria-label="Campaign portfolio summary metrics">
			<div class="summary-proof-grid">
				{
					summaryMetrics.map((item) => (
						<div class="summary-proof-card">
							<span class="summary-proof-value">{item.value}</span>
							<span class="summary-proof-title">{item.title}</span>
							<span class="summary-proof-detail">{item.detail}</span>
						</div>
					))
				}
			</div>
		</section>

		<!-- ── § I — Filterable Case Study Archive ── -->
		<section class="archive-section" aria-labelledby="archive-heading">
			<div class="section-index-header">
				<span class="section-index-badge">§ I</span>
				<h2 class="section-index-title" id="archive-heading">
					Campaign Breakdowns · Problem → Strategy → Outcome
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
				<span class="filter-status-mono" id="projects-count-label">
					Showing 6 of 6 campaigns
				</span>
			</div>

			<!-- Interactive Industry Filter Tabs -->
			<div
				class="filter-bar"
				role="toolbar"
				aria-label="Filter projects by industry and market"
			>
				{
					filterTabs.map((tab, index) => (
						<button
							type="button"
							class:list={["filter-pill", { active: index === 0 }]}
							data-filter={tab.id}
							aria-pressed={index === 0 ? "true" : "false"}
						>
							{tab.label}
						</button>
					))
				}
			</div>

			<!-- Deepened Project Cards Grid -->
			<div class="projects-grid" id="projects-grid">
				{
					projects.map((project) => (
						<article
							class="project-card"
							id={project.id}
							data-category={project.categories.join(" ")}
						>
							<!-- Top Metadata Bar -->
							<div class="card-meta-bar">
								<div class="card-badges">
									<span class="project-num">№ {project.number}</span>
									<span class="industry-badge">{project.industry}</span>
									<span class="market-badge" data-market={project.market}>
										{project.market}
									</span>
								</div>
								<span class="timeline-mono">{project.timeline}</span>
							</div>

							<!-- Title, Domain & Role -->
							<div class="card-header-block">
								<h3 class="project-name">{project.name}</h3>
								<div class="card-submeta">
									<span class="project-domain">{project.domain}</span>
									<span class="submeta-sep" aria-hidden="true">·</span>
									<span class="project-role">{project.role}</span>
								</div>
							</div>

							<!-- Highlighted KPI Metrics Box -->
							<div class="kpi-box" aria-label="Verified campaign KPIs">
								{project.metrics.map((m) => (
									<div class="kpi-item">
										<span class="kpi-value">{m.value}</span>
										<span class="kpi-label">{m.label}</span>
									</div>
								))}
							</div>

							<!-- 3-Part Structured Breakdown -->
							<dl class="breakdown-list">
								<div class="breakdown-row">
									<dt class="breakdown-term">Challenge</dt>
									<dd class="breakdown-desc">{project.challenge}</dd>
								</div>
								<div class="breakdown-row">
									<dt class="breakdown-term">Strategy &amp; Execution</dt>
									<dd class="breakdown-desc">{project.strategy}</dd>
								</div>
								<div class="breakdown-row">
									<dt class="breakdown-term">Outcome</dt>
									<dd class="breakdown-desc">{project.outcome}</dd>
								</div>
							</dl>

							<!-- Card Footer Action -->
							<div class="card-footer">
								{project.caseStudySlug ? (
									<a
										href={`/posts/${project.caseStudySlug}`}
										class="card-action-link primary-action"
									>
										Read full case study →
									</a>
								) : (
									<a
										href={`/contact?project=${project.id}`}
										class="card-action-link secondary-action"
									>
										Request similar strategy →
									</a>
								)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- ── Bottom CTA Banner ── -->
		<section class="bottom-cta-banner" aria-labelledby="projects-cta-heading">
			<div class="cta-banner-content">
				<span class="editorial-kicker">NEXT CAMPAIGN · YOUR DOMAIN</span>
				<h2 class="cta-banner-title" id="projects-cta-heading">
					Want comparable organic growth or AI search citations for your brand?
				</h2>
				<p class="cta-banner-desc">
					Share your domain and current growth bottleneck. I will review your technical architecture, topical coverage, and LLM citation footprint before proposing a clear scope.
				</p>
				<div class="cta-banner-actions">
					<a href="/contact" class="btn-primary">
						Book a consultation →
					</a>
					<a href="/services" class="btn-secondary">
						Explore consulting services →
					</a>
				</div>
			</div>
		</section>
	</div>
</Base>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
	const projectCards = document.querySelectorAll<HTMLElement>(".project-card");
	const countLabel = document.getElementById("projects-count-label");
	const totalCount = projectCards.length;

	function applyFilter(selectedCategory: string) {
		let visibleCount = 0;

		projectCards.forEach((card) => {
			const categories = (card.dataset.category || "").split(/\s+/);
			const isMatch =
				selectedCategory === "all" || categories.includes(selectedCategory);

			if (isMatch) {
				card.hidden = false;
				card.classList.remove("is-filtered-out");
				visibleCount++;
			} else {
				card.hidden = true;
				card.classList.add("is-filtered-out");
			}
		});

		filterButtons.forEach((btn) => {
			const active = btn.dataset.filter === selectedCategory;
			btn.classList.toggle("active", active);
			btn.setAttribute("aria-pressed", active ? "true" : "false");
		});

		if (countLabel) {
			countLabel.textContent = `Showing ${visibleCount} of ${totalCount} campaigns`;
		}
	}

	filterButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const category = btn.dataset.filter || "all";
			applyFilter(category);
		});
	});
</script>

<style>
	.projects-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-24);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-16);
	}

	/* ── Page Header ── */
	.page-header {
		max-width: 780px;
		padding-bottom: var(--spacing-10);
		border-bottom: 1px solid var(--color-border);
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 4.8vw, 3.5rem);
		font-weight: 600;
		font-style: normal;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.page-lead {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 66ch;
	}

	/* ── Summary Proof Bar ── */
	.summary-proof-bar {
		background: color-mix(in srgb, var(--color-bg-subtle) 65%, transparent);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
	}

	.summary-proof-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-4);
	}

	.summary-proof-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: calc(var(--radius-lg) - 2px);
		padding: var(--spacing-5);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
		box-shadow: var(--shadow-tile-raised);
	}

	.summary-proof-value {
		font-family: var(--font-mono);
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--color-accent);
	}

	.summary-proof-title {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-text);
		margin-top: var(--spacing-1);
	}

	.summary-proof-detail {
		font-family: var(--font-sans);
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--color-text-secondary);
	}

	/* ── Filter Bar ── */
	.filter-status-mono {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		white-space: nowrap;
	}

	.filter-bar {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		flex-wrap: wrap;
		margin-bottom: var(--spacing-8);
	}

	.filter-pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--spacing-2) var(--spacing-4);
		border-radius: var(--radius-full);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		cursor: pointer;
		transition:
			background-color var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.filter-pill:hover {
		border-color: var(--color-accent);
		color: var(--color-text);
	}

	.filter-pill.active {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-on-accent);
		box-shadow: var(--shadow-btn-active);
	}

	/* ── Projects Grid & Deepened Cards ── */
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-6);
	}

	.project-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-5);
		box-shadow: var(--shadow-tile-raised);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base),
			transform var(--transition-base);
	}

	.project-card[hidden] {
		display: none !important;
	}

	.project-card:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-feature);
	}

	/* Top Metadata Bar */
	.card-meta-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-3);
		flex-wrap: wrap;
		padding-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.card-badges {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.project-num {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-muted);
	}

	.industry-badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		border-radius: var(--radius);
		padding: 2px var(--spacing-2);
	}

	.market-badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--color-text);
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 2px var(--spacing-2);
	}

	.timeline-mono {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	/* Header Block */
	.card-header-block {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
	}

	.project-name {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.card-submeta {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		flex-wrap: wrap;
	}

	.project-domain {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-accent);
	}

	.submeta-sep {
		color: var(--color-muted);
	}

	.project-role {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	/* KPI Box */
	.kpi-box {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-3);
		padding: var(--spacing-4);
