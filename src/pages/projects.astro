		industry: "Furniture Dropshipping",
		market: "Global",
		categories: ["ecommerce", "international", "geo"],
		role: "Lead SEO & GEO Strategist",
		metrics: [
			{ value: "100%", label: "KPI in 5 Months" },
			{ value: "3+/mo", label: "High-Ticket Organic Orders" },
			{ value: "Global", label: "English SERP & Entity Footprint" },
		],
		challenge:
			"Newly launched English-language furniture dropshipping store had zero domain authority, duplicate manufacturer copy, and no entity recognition in global search.",
		strategy:
			"Executed end-to-end entity establishment, technical crawl budget optimization, programmatic Product & Merchant listing schema, and long-tail collection architecture.",
