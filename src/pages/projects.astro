---

<Base
	title="Case Studies & Verifiable SEO/GEO Projects"
	description="6 flagship SEO and Generative Engine Optimization (GEO) projects led by Le Hoang Tin at GTV SEO — IndochinaLight, Repair Centre VIC, GTV SEO, Vinamilk, Shadow Vietnam, and EuroTravel."
>
	<div class="projects-page">
		<!-- ── Page Header ── -->
		<header class="page-header">
			<div class="page-header-top">
				<div>
					<span class="editorial-kicker">VERIFIED CASE STUDIES · GTV SEO TENURE (NOV 2022 – APR 2025)</span>
					<h1 class="page-title">6 Flagship SEO &amp; GEO Case Studies</h1>
					<p class="page-lead">
						Every campaign below reflects verified execution as Lead &amp; Primary Implementer or Advisor at <strong>GTV SEO</strong> across global dropshipping e-commerce, Australian local services, B2B agency GEO, enterprise FMCG nutrition, tactical retail, and European tourism.
					</p>
				</div>
				<div class="page-header-actions">
					<a href="/portfolio" class="btn-primary">
						Open Visual Portfolio Deck (/portfolio) →
					</a>
					<a href="/#get-in-touch" class="btn-secondary">
						Get in Touch →
					</a>
				</div>
			</div>
		</header>

		<!-- ── Summary Proof Bar ── -->
		<section class="summary-proof-bar" aria-label="Campaign portfolio summary metrics">
			<div class="summary-proof-grid">
				{
					summaryMetrics.map((item) => (
						<div class="summary-proof-card">
							<span class="summary-proof-value">{item.value}</span>
							<span class="summary-proof-title">{item.title}</span>
							<span class="summary-proof-detail">{item.detail}</span>
						</div>
					))
				}
			</div>
		</section>

		<!-- ── § I — Filterable Case Study Archive ── -->
		<section class="archive-section" aria-labelledby="archive-heading">
			<div class="section-index-header">
				<span class="section-index-badge">§ I</span>
				<h2 class="section-index-title" id="archive-heading">
					Campaign Breakdowns · Role → Task Executed → Verified Result
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
				<span class="filter-status-mono" id="projects-count-label">
					Showing 6 of 6 campaigns
				</span>
			</div>

			<!-- Interactive Industry Filter Tabs -->
			<div
				class="filter-bar"
				role="toolbar"
				aria-label="Filter projects by industry and market"
			>
				{
					filterTabs.map((tab, index) => (
						<button
							type="button"
							class:list={["filter-pill", { active: index === 0 }]}
							data-filter={tab.id}
							aria-pressed={index === 0 ? "true" : "false"}
						>
							{tab.label}
						</button>
					))
				}
			</div>

			<!-- Deepened Project Cards Grid -->
			<div class="projects-grid" id="projects-grid">
				{
					projects.map((project) => (
						<article
							class="project-card"
							id={project.id}
							data-category={project.categories.join(" ")}
						>
							<!-- Top Metadata Bar -->
							<div class="card-meta-bar">
								<div class="card-badges">
									<span class="project-num">№ {project.number}</span>
									<span class="industry-badge">{project.industry}</span>
									<span class="market-badge">{project.market}</span>
								</div>
								<span class="timeline-mono">{project.timeline}</span>
							</div>

							<!-- Title, Domain & Role -->
							<div class="card-header-block">
								<h3 class="project-name">{project.name}</h3>
								<div class="card-submeta">
									{project.domainUrl ? (
										<a
											href={project.domainUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="project-domain"
										>
											{project.domain} ↗
										</a>
									) : (
										<span class="project-domain">{project.domain}</span>
									)}
									<span class="submeta-sep" aria-hidden="true">·</span>
									<span class="project-role">{project.role}</span>
								</div>
							</div>

							<!-- Highlighted KPI Metrics Box -->
							<div class="kpi-box" aria-label="Verified campaign KPIs">
								{project.metrics.map((m) => (
									<div class="kpi-item">
										<span class="kpi-value">{m.value}</span>
										<span class="kpi-label">{m.label}</span>
									</div>
								))}
							</div>

							<!-- Structured Task & Result Breakdown -->
							<dl class="breakdown-list">
								<div class="breakdown-row">
									<dt class="breakdown-term">Task Executed</dt>
									<dd class="breakdown-desc">{project.task}</dd>
								</div>
								<div class="breakdown-row">
									<dt class="breakdown-term">Verified Result</dt>
									<dd class="breakdown-desc">{project.result}</dd>
								</div>
							</dl>

							<!-- Proof Chart Thumbnails (if available) -->
							{project.proofImages && project.proofImages.length > 0 && (
								<div class="proof-thumbs-block">
									<span class="proof-thumbs-label">VERIFIED ANALYTICS PROOF (CLICK TO ZOOM)</span>
									<div
										class:list={[
											"proof-thumbs-grid",
											{ "two-up": project.proofImages.length > 1 },
										]}
									>
										{project.proofImages.map((img) => (
											<button
												type="button"
												class="proof-thumb-btn"
												data-lightbox-src={img.src}
												data-lightbox-alt={img.alt}
												data-lightbox-caption={img.caption}
											>
												<img
													src={img.src}
													alt={img.alt}
													class="proof-thumb-img"
													loading="lazy"
												/>
												<span class="proof-thumb-caption">{img.caption}</span>
											</button>
										))}
									</div>
								</div>
							)}

							<!-- Card Footer Action -->
							<div class="card-footer">
								<a href={project.portfolioSlide} class="card-action-link primary-action">
									View visual deck slide →
								</a>
								{project.caseStudySlug ? (
									<a
										href={`/posts/${project.caseStudySlug}`}
										class="card-action-link secondary-action"
									>
										Read full case study →
									</a>
								) : (
									<a
										href={`/contact?project=${project.id}`}
										class="card-action-link secondary-action"
									>
										Get in Touch →
									</a>
								)}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- ── Bottom CTA Banner ── -->
		<section class="bottom-cta-banner" aria-labelledby="projects-cta-heading">
			<div class="cta-banner-content">
				<span class="editorial-kicker">NEXT CAMPAIGN · YOUR DOMAIN</span>
				<h2 class="cta-banner-title" id="projects-cta-heading">
					Want comparable organic growth or #1 AI search citations for your brand?
				</h2>
				<p class="cta-banner-desc">
					Explore the full 10-slide Visual Strategy Deck or reach out directly with your website URL and growth objectives.
				</p>
				<div class="cta-banner-actions">
					<a href="/#get-in-touch" class="btn-primary">
						Get in Touch →
					</a>
					<a href="/portfolio" class="btn-secondary">
						Open Visual Portfolio Deck (/portfolio) →
					</a>
				</div>
			</div>
		</section>
	</div>

	<!-- Lightbox Modal for Proof Screenshots -->
	<div
		id="projects-lightbox"
		class="lightbox-backdrop"
		role="dialog"
		aria-modal="true"
		aria-label="Analytics proof screenshot preview"
		hidden
	>
		<div class="lightbox-dialog">
			<div class="lightbox-top">
				<span id="projects-lightbox-caption" class="lightbox-caption"></span>
				<button
					type="button"
					id="projects-lightbox-close"
					class="lightbox-close-btn"
					aria-label="Close preview"
				>
					Close ✕
				</button>
			</div>
			<div class="lightbox-img-wrap">
				<img id="projects-lightbox-img" src="" alt="" class="lightbox-img" />
			</div>
		</div>
	</div>
</Base>

<script>
	const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-pill");
	const projectCards = document.querySelectorAll<HTMLElement>(".project-card");
	const countLabel = document.getElementById("projects-count-label");
	const totalCount = projectCards.length;

	function applyFilter(selectedCategory: string) {
		let visibleCount = 0;

		projectCards.forEach((card) => {
			const categories = (card.dataset.category || "").split(/\s+/);
			const isMatch =
				selectedCategory === "all" || categories.includes(selectedCategory);

			if (isMatch) {
				card.hidden = false;
				card.classList.remove("is-filtered-out");
				visibleCount++;
			} else {
				card.hidden = true;
				card.classList.add("is-filtered-out");
			}
		});

		filterButtons.forEach((btn) => {
			const active = btn.dataset.filter === selectedCategory;
			btn.classList.toggle("active", active);
			btn.setAttribute("aria-pressed", active ? "true" : "false");
		});

		if (countLabel) {
			countLabel.textContent = `Showing ${visibleCount} of ${totalCount} campaigns`;
		}
	}

	filterButtons.forEach((btn) => {
		btn.addEventListener("click", () => {
			const category = btn.dataset.filter || "all";
			applyFilter(category);
		});
	});

	// Lightbox modal
	const lightbox = document.getElementById("projects-lightbox");
	const lightboxImg = document.getElementById("projects-lightbox-img") as HTMLImageElement | null;
	const lightboxCaption = document.getElementById("projects-lightbox-caption");
	const lightboxClose = document.getElementById("projects-lightbox-close");
	const thumbBtns = document.querySelectorAll<HTMLButtonElement>(".proof-thumb-btn");

	function closeLightbox() {
		if (!lightbox) return;
		lightbox.hidden = true;
		document.body.style.overflow = "";
	}

	thumbBtns.forEach((btn) => {
		btn.addEventListener("click", () => {
			if (!lightbox || !lightboxImg) return;
			lightboxImg.src = btn.dataset.lightboxSrc || "";
			lightboxImg.alt = btn.dataset.lightboxAlt || "";
			if (lightboxCaption) {
				lightboxCaption.textContent = btn.dataset.lightboxCaption || "";
			}
			lightbox.hidden = false;
			document.body.style.overflow = "hidden";
		});
	});

	lightboxClose?.addEventListener("click", closeLightbox);
	lightbox?.addEventListener("click", (e) => {
		if (e.target === lightbox) closeLightbox();
	});
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && lightbox && !lightbox.hidden) {
			closeLightbox();
		}
	});
</script>

<style>
	.projects-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-24);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-16);
	}

	/* ── Page Header ── */
	.page-header {
		padding-bottom: var(--spacing-10);
		border-bottom: 1px solid var(--color-border);
	}

	.page-header-top {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--spacing-8);
		flex-wrap: wrap;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 4.8vw, 3.5rem);
		font-weight: 600;
		font-style: normal;
		line-height: 1.1;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: var(--spacing-4);
	}

	.page-lead {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 64ch;
	}

	.page-lead strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.page-header-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		flex-wrap: wrap;
		flex-shrink: 0;
	}

	/* ── Summary Proof Bar ── */
	.summary-proof-bar {
		background: color-mix(in srgb, var(--color-bg-subtle) 65%, transparent);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-6);
	}

	.summary-proof-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--spacing-4);
	}

	.summary-proof-card {
