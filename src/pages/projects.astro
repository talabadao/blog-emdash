---
import Base from "../layouts/Base.astro";

interface ProjectMetric {
	value: string;
	label: string;
}

interface ProofAsset {
	src: string;
	alt: string;
	caption: string;
}

interface ProjectItem {
	id: string;
	number: string;
	name: string;
	domain: string;
	domainUrl?: string;
	timeline: string;
	industry: string;
	market: string;
	categories: string[];
	role: string;
	metrics: ProjectMetric[];
	task: string;
	result: string;
	proofImages?: ProofAsset[];
	caseStudySlug: string | null;
	portfolioSlide: string;
}

const summaryMetrics = [
	{
		value: "6",
		title: "Flagship Projects at GTV SEO",
		detail: "Nov 2022 – Apr 2025 · Lead & Primary Implementer / Advisor",
	},
	{
		value: "300K+",
		title: "Monthly Clicks (GSC)",
		detail: "826,000+ total clicks & 320,000 monthly traffic on Vinamilk",
	},
	{
		value: "Top 1",
		title: "ChatGPT, Grok & Claude",
		detail: 'Recommended #1 for "seo agency hcm" & "công ty seo hcm"',
	},
	{
		value: "100%–120%",
		title: "SEO KPI Delivery",
		detail: "Across Vietnam, Australia, US, Singapore & Italy",
