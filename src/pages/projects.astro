	},
	{
		id: "eurotravel",
		number: "04",
		name: "European Travel (EuroTravel)",
		domain: "eurotravel.com.vn",
		domainUrl: "https://eurotravel.com.vn",
		timeline: "Nov 2022 – May 2023",
		industry: "High-Ticket Travel",
		market: "VN",
		categories: ["travel"],
		role: "Lead Implementer",
		metrics: [
			{ value: "80K–100K", label: "Monthly Organic Clicks" },
			{ value: "120%", label: "KPI Delivered in 6 Months" },
