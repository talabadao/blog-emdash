	},
	{
		id: "repair-au",
		number: "02",
		name: "Repair Centre VIC",
		domain: "repaircentrevic.com.au",
		domainUrl: "https://repaircentrevic.com.au",
		timeline: "Feb 2025",
		industry: "Local & Technical SEO",
