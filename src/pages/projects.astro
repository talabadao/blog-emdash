	name: string;
	domain: string;
	domainUrl?: string;
	timeline: string;
	industry: string;
	market: "VN" | "AU" | "Global";
	categories: string[];
	role: string;
	metrics: ProjectMetric[];
	challenge: string;
	strategy: string;
	outcome: string;
	caseStudySlug: string | null;
