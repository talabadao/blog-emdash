];

const filterTabs = [
	{ id: "all", label: "All (6)" },
	{ id: "ecommerce", label: "E-Commerce & FMCG" },
	{ id: "international", label: "Global & Australia" },
	{ id: "geo", label: "B2B Agency & AI Search (GEO)" },
	{ id: "travel", label: "European Travel" },
];

const projects: ProjectItem[] = [
	{
		id: "indochinalight",
		number: "01",
		name: "IndochinaLight | Global Dropshipping E-Commerce Project",
		domain: "Global Storefront (US, Singapore, Italy, Australia)",
		timeline: "Nov 2024 – Apr 2025 · 6 mos",
		industry: "Furniture & Lighting Dropshipping",
		market: "Global",
		categories: ["ecommerce", "international"],
		role: "Lead & Primary Implementer (SEO Specialist)",
		metrics: [
			{ value: "100%", label: "SEO KPIs in First 3–5 Mos" },
			{ value: "Top 10", label: '"rattan pendant light"' },
			{ value: "+409%", label: "Sales ($7,504.98 · 19 Orders)" },
		],
		task:
			"Analyzed the Website (Entity, Technical, Content) & market overview; developed an overall SEO strategy for a new-domain dropshipping e-commerce store targeting the US, Singapore, Italy, and Australia.",
		result:
			'Achieved 100% SEO KPIs in the first 3–5 months, main keyword "rattan pendant light" ranked in Top 10, and achieved an average of 2–3+ organic orders/month ($7,504.98 total sales +409%, 19 orders +280%, 6,310 sessions +23%, +176% conversion rate).',
		proofImages: [
			{
				src: "/proof/furniture-shopify-conversions.png",
				alt: "IndochinaLight Shopify organic revenue and conversion growth ($7,504.98 total sales +409%, 19 orders +280%)",
				caption: "Shopify Analytics: $7,504.98 Total Sales (+409%) · 19 Orders (+280%) · 6,310 Sessions (+23%)",
			},
		],
		caseStudySlug: null,
		portfolioSlide: "/portfolio#slide-indochinalight",
	},
	{
		id: "repair-au",
		number: "02",
		name: "Repair Centre VIC | Electronic Equipment Service Project",
		domain: "repaircentrevic.com.au",
		domainUrl: "https://repaircentrevic.com.au/",
		timeline: "Feb 2025 · 1 mo",
		industry: "Electronic Equipment Service",
		market: "Australia",
		categories: ["international"],
		role: "Advisor & Implementer Achieving Project-End KPIs (SEO Specialist)",
		metrics: [
			{ value: "Top 3–5", label: "AU Rankings in 2 Weeks" },
			{ value: "85%", label: "Overall KPI After 2 Weeks" },
			{ value: "75%", label: "TOP 10 KPI (Up from 55%)" },
		],
		task:
			"Audited Website, identified Keyword Cannibalization and Duplicate Content. Strategized optimization for final project month to hit KPIs.",
		result:
			'Achieved Top 3–5 rankings for "iPhone ... screen repair", "Samsung ... screen repair" in the Australian market within 2 weeks. Achieved 75% TOP 10 KPI (from 55%), 30% TOP 5 KPI (from 15%), 10% TOP 3 KPI (from 5%), and 85% overall KPI after 2 weeks of Content & Onsite Audit.',
		caseStudySlug: "top-3-rankings-in-two-weeks",
		portfolioSlide: "/portfolio#slide-repair-vic",
	},
	{
		id: "gtv-agency",
		number: "03",
		name: "GTV SEO Project | B2B SEO Agency",
		domain: "gtvseo.com",
		domainUrl: "https://gtvseo.com/",
		timeline: "Apr 2023 – Dec 2024 · 1 yr 9 mos",
		industry: "B2B SEO Agency & GEO",
		market: "Vietnam",
		categories: ["geo"],
		role: "Lead & Primary Implementer (SEO Specialist)",
		metrics: [
			{ value: "Top 1", label: "ChatGPT, Grok & Claude" },
			{ value: "Top 1–3", label: '"báo giá seo", "khóa học seo"' },
			{ value: "40/mo", label: "AI-Assisted Quality Articles" },
		],
		task:
			"Executed tasks per plan (Schema, Content Audit, balanced Internal Linking, Crawl optimization, Cloud Stack, Guest Posts, PR articles, User Traffic, etc.). Applied AI to write and publish 40 quality articles/month for the website.",
		result:
			'Achieved Top 1 recommendation for "seo agency hcm" & "công ty seo hcm" on AI search engines (ChatGPT, Grok, Claude). Achieved stable Top 1–3 rankings for "báo giá seo", "khóa học seo", "seo agency", "thiết kế website chuẩn seo". Maintained stable Top 5–7 rankings for "dịch vụ seo hcm", "đào tạo seo" in 6 months using White Hat SEO methods in a Black Hat-dominated industry.',
		caseStudySlug: "geo-playbook-ranking-number-1-on-chatgpt-claude-and-grok",
		portfolioSlide: "/portfolio#slide-gtv-seo",
	},
	{
		id: "vinamilk",
		number: "04",
		name: "Vinamilk | Nutrition E-Commerce Project",
		domain: "vinamilk.com.vn",
		domainUrl: "https://www.vinamilk.com.vn/",
		timeline: "Nov 2023 – Mar 2024 · 5 mos",
		industry: "Nutrition E-Commerce (Enterprise FMCG)",
		market: "Vietnam",
		categories: ["ecommerce"],
		role: "Lead & Primary Implementer (SEO Specialist)",
		metrics: [
			{ value: "300K/mo", label: "GSC Clicks (826K+ Total)" },
			{ value: "320K/mo", label: "Monthly Organic Traffic" },
			{ value: "100%", label: "SEO KPIs After 5 Months" },
		],
		task:
			"Executed tasks (Technical Audit, UI-UX optimization, Keyword grouping, Topical Map, Content Outlines, Onpage Checklist).",
		result:
			"Reached 300,000 clicks/month (GSC) and 320,000 monthly traffic (826,000+ total clicks & 15.9M impressions in GSC), hitting 100% of SEO KPIs after 5 months. Traffic mainly came from topics on mom and baby nutrition, milk, recipes, etc. Achieved Top 1–3 rankings for keywords related to nutritional products, baby cereal, baby milk, etc.",
		proofImages: [
			{
				src: "/proof/vinamilk-gsc-826k-clicks.png",
				alt: "Vinamilk Google Search Console performance chart showing 826,000+ total clicks and 300,000 monthly clicks",
				caption: "Google Search Console: 826K+ Total Clicks · 15.9M Impressions · 300K Clicks/Month Peak",
			},
		],
		caseStudySlug: "scaling-vinamilk-to-300k-monthly-organic-clicks",
		portfolioSlide: "/portfolio#slide-vinamilk",
	},
	{
		id: "shadow-vn",
		number: "05",
		name: "Shadow Vietnam | Flashlight E-Commerce Project",
		domain: "shadow.vn",
		timeline: "Apr 2023 – Nov 2023 · 8 mos",
		industry: "Tactical Flashlight E-Commerce",
		market: "Vietnam",
		categories: ["ecommerce"],
		role: "Lead & Primary Implementer (SEO Executive)",
		metrics: [
			{ value: "+25% MoM", label: "Website Revenue (+26.81%)" },
			{ value: "100%", label: "SEO KPI Delivered" },
			{ value: "+25% YoY", label: "Q4/2023 + Military Contract" },
		],
		task:
			"Audited website quarterly, optimized Product Page Views and Time Onsite, boosting website revenue by 25% month-over-month (+26.81% verified revenue growth to 225,246,800 VND & 57,311 users / 71,291 sessions).",
		result:
			'Achieved 100% SEO KPI, maintained traffic, main Product and Category TOP rankings ("địa điểm cắm trại", "đèn pin cắm trại", "đèn pin siêu sáng"). Q4/2023 revenue increased 25% year-over-year, secured a flashlight supply contract with the military, and renewed the SEO website contract with GTV.',
		proofImages: [
			{
				src: "/proof/flashlight-revenue-growth.png",
				alt: "Shadow Vietnam GA4 e-commerce revenue growth +26.81% to 225,246,800 VND",
				caption: "GA4 E-Commerce Revenue: +26.81% MoM Growth (225,246,800 VND)",
			},
			{
				src: "/proof/flashlight-traffic-growth.png",
				alt: "Shadow Vietnam GA4 organic traffic growth (57,311 users and 71,291 sessions)",
				caption: "GA4 Traffic & Engagement: 57,311 Users · 71,291 Sessions",
			},
		],
		caseStudySlug: null,
		portfolioSlide: "/portfolio#slide-shadow-vietnam",
	},
	{
		id: "eurotravel",
		number: "06",
		name: "EuroTravel | European Travel Project",
		domain: "eurotravel.com.vn",
		domainUrl: "https://eurotravel.com.vn/",
		timeline: "Nov 2022 – May 2023 · 7 mos",
		industry: "European Travel",
		market: "Vietnam",
		categories: ["travel"],
		role: "Lead & Primary Implementer (SEO Trainee)",
		metrics: [
			{ value: "100K/mo", label: "Monthly Traffic (102.5K Peak)" },
			{ value: "80K/mo", label: "GSC Clicks (20K Guides)" },
			{ value: "120%", label: "TOP KPI Targets in 6 Mos" },
		],
		task:
			"Planned and executed tasks per GTV's SEO process, achieving 100,000 monthly traffic (102,544 peak organic traffic in Semrush) and 120% TOP KPI targets in 6 months.",
		result:
			"Reached 80,000 clicks/month (GSC), including 20,000 from articles on tips, locations, and experiences when traveling in Europe, Australia, and New Zealand. Ranked Top 1 for European tours by country, luxury European travel, and Europe tours during Tet; Top 3 for European tour keywords by travel route.",
		proofImages: [
			{
				src: "/proof/eurotravel-semrush-traffic.png",
				alt: "EuroTravel Semrush organic traffic chart reaching 102,544 monthly visits",
				caption: "Semrush Domain Overview: 102,544 Monthly Organic Traffic · 80,000 GSC Clicks/Month",
			},
		],
		caseStudySlug: null,
		portfolioSlide: "/portfolio#slide-eurotravel",
