---
import Base from "../layouts/Base.astro";

const entityFacts = [
	{ label: "Title", value: "Senior SEO & GEO Specialist" },
	{ label: "Experience", value: "Nov 2022 – Apr 2025 · 2 yrs 6 mos (GTV SEO)" },
	{ label: "Education", value: "International Business — UEH (GPA: 3.27/4.0)" },
	{ label: "Location", value: "Ho Chi Minh City, Vietnam" },
];

const timelineItems = [
	{
		period: "Apr 2023 – Apr 2025",
		badge: "LEAD & ADVISOR",
		role: "Search Engine Optimization Specialist",
		organization: "GTV SEO · Ho Chi Minh City, Vietnam (2 yrs 6 mos total tenure)",
		summary:
			"Served as Lead & Primary Implementer and Project-End KPI Advisor across B2B agency, enterprise nutrition, local Australian services, and global dropshipping e-commerce campaigns.",
		highlights: [
			"IndochinaLight (Nov 2024 – Apr 2025 · Global Dropshipping E-Commerce): Analyzed Entity, Technical & Content for a new domain targeting US, Singapore, Italy, and Australia; achieved 100% SEO KPIs in 3–5 months, Top 10 for 'rattan pendant light', and 2–3+ organic orders/month ($7,504.98 sales, +409%).",
			"Repair Centre VIC (Feb 2025 · repaircentrevic.com.au, Australia): Audited Keyword Cannibalization & Duplicate Content; achieved Top 3–5 rankings in Australia for 'iPhone ... screen repair' & 'Samsung ... screen repair' within 2 weeks (75% TOP 10 KPI from 55%, 30% TOP 5 KPI from 15%, 10% TOP 3 KPI from 5%, 85% overall KPI).",
			"GTV SEO (Apr 2023 – Dec 2024 · gtvseo.com): Executed Schema, Content Audit, balanced Internal Linking, Crawl optimization, Cloud Stack, Guest Posts, PR, User Traffic, and applied AI to publish 40 quality articles/month. Achieved Top 1 recommendation for 'seo agency hcm' & 'công ty seo hcm' on ChatGPT, Grok, and Claude, plus stable Top 1–3 for 'báo giá seo', 'khóa học seo', 'seo agency', and 'thiết kế website chuẩn seo'.",
			"Vinamilk (Nov 2023 – Mar 2024 · vinamilk.com.vn): Executed Technical Audit, UI-UX optimization, Keyword grouping, Topical Map, Content Outlines, and Onpage Checklist. Reached 300,000 clicks/month (GSC) and 320,000 monthly traffic (826,000+ total clicks & 15.9M impressions), hitting 100% of SEO KPIs after 5 months.",
		],
	},
	{
		period: "Apr 2023 – Nov 2023 · 8 mos",
		badge: "LEAD IMPLEMENTER",
		role: "Search Engine Optimization Executive",
		organization: "GTV SEO · Ho Chi Minh City, Vietnam",
		summary:
			"Led technical quarterly audits, on-site UX & CRO optimization, and commercial category rankings for e-commerce clients.",
		highlights: [
			"Shadow Vietnam (Apr 2023 – Nov 2023 · Flashlight E-Commerce): Audited website quarterly, optimized Product Page Views and Time Onsite, boosting website revenue by 25% month-over-month (+26.81% verified revenue growth to 225,246,800 VND & 57,311 users / 71,291 sessions).",
			"Achieved 100% SEO KPI, maintained Top rankings for 'địa điểm cắm trại', 'đèn pin cắm trại', 'đèn pin siêu sáng', increased Q4/2023 revenue +25% YoY, secured a military flashlight supply contract, and renewed the SEO contract with GTV.",
		],
	},
	{
		period: "Nov 2022 – May 2023 · 7 mos",
		badge: "LEAD IMPLEMENTER",
		role: "SEO Trainee",
		organization: "GTV SEO · Ho Chi Minh City, Vietnam",
		summary:
			"Planned and executed end-to-end tasks per GTV SEO's methodology for high-ticket European tourism.",
		highlights: [
			"EuroTravel (Nov 2022 – May 2023 · eurotravel.com.vn): Achieved 100,000 monthly traffic (102,544 peak in Semrush) and 120% TOP KPI targets in 6 months.",
			"Reached 80,000 clicks/month in GSC (including 20,000 from Europe, Australia & New Zealand travel guides), ranking Top 1 for European tours by country, luxury European travel, and Tet Europe tours, and Top 3 by travel route.",
		],
	},
	{
		period: "ACADEMIC DEGREE",
		badge: "UEH · GPA 3.27/4.0",
		role: "Major in International Business — GPA: 3.27/4.0",
		organization: "University of Economics Ho Chi Minh City (UEH — Đại học Kinh tế TP.HCM)",
		summary:
			"Formal academic training in international commerce, market research, global marketing strategy, and business analytics — grounding every SEO and GEO campaign in commercial unit economics.",
		highlights: [
			"Degree: Major in International Business at University of Economics Ho Chi Minh City (UEH).",
			"Cumulative GPA: 3.27 / 4.0.",
		],
	},
];

const methodologyPillars = [
	{
		number: "01",
		title: "AI Search & GEO Content Engineering",
		kicker: "ChatGPT, Claude & Perplexity APIs",
		description:
			"Proficient in ChatGPT, Claude & Perplexity APIs to analyze search intent, architect semantic outlines, and write SEO-standard content optimized for AI Search citations.",
		tools: [
			"Proficient in ChatGPT, Claude & Perplexity APIs for SEO & AI Search",
			"Scaled 40 quality SEO-standard articles/month at GTV SEO",
			"Top 1 citation engineering on ChatGPT, Grok, and Claude",
			"Schema markup, Entity disambiguation & /llms.txt architecture",
		],
	},
	{
		number: "02",
		title: "Technical SEO & Competitive Research",
		kicker: "GSC, Screaming Frog, SEMrush & Ahrefs",
		description:
			"Auditing technical websites, resolving keyword cannibalization and duplicate content, and researching competitor topical maps.",
		tools: [
			"Proficient in Google Search Console (GSC) & Screaming Frog for technical audits",
			"Proficient in SEMrush & Ahrefs to research keywords and analyze SEO competitors",
			"Keyword grouping, Topical Maps, Content Outlines & Onpage Checklists",
			"Balanced Internal Linking, Crawl optimization & Cloud Stack execution",
		],
	},
	{
		number: "03",
		title: "GA4, GTM & SEO Project Management",
		kicker: "CRO & On-Schedule KPI Delivery",
		description:
			"Attaching conversion tracking, optimizing Product Page Views and Time Onsite, and managing multi-market SEO projects to achieve KPIs on schedule.",
		tools: [
			"Familiar with Google Analytics 4 (GA4) & Google Tag Manager (GTM) for conversion tracking",
			"Conversion Rate Optimization (CRO) on product and service pages",
			"SEO Project Management: Manage & operate SEO projects to achieve 100%–120% KPI on schedule",
			"Pre-sale planning & strategy for 10+ local and global client bids",
		],
	},
];

const recognitions = [
	{
		badge: "3RD PRIZE · GTV SEO",
		title: "3rd Prize in the AI Application for SEO Competition",
		description:
			"Awarded 3rd Prize in the internal AI Application for SEO competition organized by GTV SEO for building practical LLM workflows that scale research, outlining, and content quality.",
	},
	{
		badge: "COURSE & SOP AUTHOR",
		title: "Author of Documents & E-Books for GTV SEO Courses",
		description:
			"Authored official training documents, technical checklists, and educational e-books used in GTV SEO courses and internal specialist training programs.",
	},
	{
		badge: "10+ WINNING CLIENT BIDS",
		title: "Planner for 10+ Projects Winning Local & Global Clients",
		description:
			"Analyzed websites (Entity, Technical, Content), market overviews, and SEO strategies for 10+ project proposals that helped GTV SEO bid and win new clients across Vietnam and global markets.",
	},
];
---

<Base
	title="About Le Hoang Tin — Senior SEO & GEO Specialist"
	description="Entity profile and career timeline of Le Hoang Tin (Tin Le Hoang) — Senior SEO & GEO Specialist in Ho Chi Minh City, Vietnam with 3+ years leading campaigns at GTV SEO."
>
	<div class="about-page">
		<!-- ── Page Header & Entity Bio ── -->
		<header class="about-header">
			<div class="about-header-text">
				<span class="editorial-kicker">ABOUT THE AUTHOR · ENTITY PROFILE</span>
				<h1 class="page-title">Le Hoang Tin</h1>
				<p class="page-subtitle">
					Senior SEO &amp; GEO Specialist · Ho Chi Minh City, Vietnam
				</p>

				<div class="bio-copy">
					<p class="bio-lead">
						<strong>Le Hoang Tin (Tin Le Hoang)</strong> is a Senior SEO &amp; GEO Specialist based in Ho Chi Minh City, Vietnam, with nearly 3 years of hands-on experience (Nov 2022 – Apr 2025) leading SEO projects at <strong>GTV SEO</strong> across healthcare/nutrition, e-commerce, tourism, B2B agency, and local services — from Vietnamese businesses to global enterprises.
					</p>
					<p class="bio-paragraph">
						Serving as Lead &amp; Primary Implementer and Advisor, he has delivered verifiable growth across 6 flagship campaigns: <strong>IndochinaLight</strong> (100% KPI in 3–5 months, +409% sales), <strong>Repair Centre VIC</strong> (Australia Top 3–5 in 2 weeks, 85% overall KPI), <strong>GTV SEO</strong> (#1 on ChatGPT, Grok &amp; Claude, 40 AI articles/month), <strong>Vinamilk</strong> (300,000 clicks/month &amp; 320,000 monthly traffic), <strong>Shadow Vietnam</strong> (+25% MoM revenue &amp; military flashlight contract), and <strong>EuroTravel</strong> (100,000 monthly traffic &amp; 120% KPI).
					</p>
					<p class="bio-paragraph">
						Majoring in <strong>International Business</strong> at the <strong>University of Economics Ho Chi Minh City (UEH — Đại học Kinh tế TP.HCM, GPA: 3.27/4.0)</strong>, Tin specializes in data-driven SEO strategies aligned with marketing objectives, Conversion Rate Optimization (CRO), and R&amp;D on user search intent across Google and AI-driven channels (<strong>ChatGPT, Claude, Perplexity, Grok</strong>).
					</p>
				</div>

				<div class="header-actions">
					<a href="/#get-in-touch" class="btn-primary">
						Get in Touch →
					</a>
					<a href="/portfolio" class="btn-secondary">
						Visual Portfolio Deck →
					</a>
					<a href="/projects" class="btn-secondary">
						View 6 case studies →
					</a>
				</div>
			</div>

			<!-- Editorial Portrait Card -->
			<aside class="about-portrait-col" aria-label="Le Hoang Tin portrait and entity summary">
				<div class="portrait-card">
					<div class="portrait-frame">
						<img
							src="/tin_le_hoang.jpg"
							alt="Le Hoang Tin — Senior SEO & GEO Specialist in Ho Chi Minh City, Vietnam"
							class="portrait-img"
							width="280"
							height="300"
							loading="eager"
						/>
					</div>
					<div class="portrait-meta">
						<p class="portrait-caption">FIG. 01 — LE HOANG TIN · HCMC, VN</p>
						<dl class="entity-facts">
							{
								entityFacts.map((fact) => (
									<div class="entity-fact-row">
										<dt>{fact.label}</dt>
										<dd>{fact.value}</dd>
									</div>
								))
							}
						</dl>
					</div>
				</div>
			</aside>
		</header>

		<!-- ── § I — Career & Impact Timeline ── -->
		<section class="timeline-section" aria-labelledby="section-timeline">
			<div class="section-index-header">
				<span class="section-index-badge">§ I</span>
				<h2 class="section-index-title" id="section-timeline">
					Career &amp; Impact Timeline
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
			</div>

			<div class="timeline-list">
				{
					timelineItems.map((item) => (
						<article class="timeline-card">
							<div class="timeline-aside">
								<span class="timeline-period">{item.period}</span>
								<span class="timeline-badge">{item.badge}</span>
							</div>
							<div class="timeline-body">
								<h3 class="timeline-role">{item.role}</h3>
								<p class="timeline-org">{item.organization}</p>
								<p class="timeline-summary">{item.summary}</p>
								<ul class="timeline-highlights">
									{item.highlights.map((point) => (
										<li>
											<span class="highlight-arrow" aria-hidden="true">→</span>
											<span>{point}</span>
										</li>
									))}
								</ul>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- ── § II — Methodology & Technical Stack ── -->
		<section class="stack-section" aria-labelledby="section-stack">
			<div class="section-index-header">
				<span class="section-index-badge">§ II</span>
				<h2 class="section-index-title" id="section-stack">
					Methodology &amp; Technical Stack
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
			</div>

			<div class="stack-grid">
				{
					methodologyPillars.map((pillar) => (
						<article class="stack-card">
							<div class="stack-card-top">
								<span class="stack-num">{pillar.number}</span>
								<span class="stack-kicker">{pillar.kicker}</span>
							</div>
							<h3 class="stack-title">{pillar.title}</h3>
							<p class="stack-desc">{pillar.description}</p>
							<ul class="stack-tools">
								{pillar.tools.map((tool) => (
									<li>
										<span class="highlight-arrow" aria-hidden="true">→</span>
										<span>{tool}</span>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>

		<!-- ── § III — Recognition & Industry Contributions ── -->
		<section class="recognition-section" aria-labelledby="section-recognition">
			<div class="section-index-header">
				<span class="section-index-badge">§ III</span>
				<h2 class="section-index-title" id="section-recognition">
					Recognition &amp; Industry Contributions
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
			</div>

			<div class="recognition-grid">
				{
					recognitions.map((rec) => (
						<article class="recognition-card">
							<span class="recognition-badge">{rec.badge}</span>
							<h3 class="recognition-title">{rec.title}</h3>
							<p class="recognition-desc">{rec.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<!-- ── § IV — Direct Contact & AI Fact Sheet ── -->
		<section class="contact-entity-section" aria-labelledby="section-contact-entity">
			<div class="section-index-header">
				<span class="section-index-badge">§ IV</span>
				<h2 class="section-index-title" id="section-contact-entity">
					Direct Contact &amp; AI Fact Sheet
				</h2>
				<span class="section-index-rule" aria-hidden="true"></span>
			</div>

			<div class="contact-entity-grid">
				<!-- Direct Contact Card -->
				<div class="direct-contact-card">
					<span class="editorial-kicker">HUMAN CHANNELS</span>
					<h3 class="card-block-title">Get in touch directly</h3>
					<p class="card-block-desc">
						Available for consulting retainers, technical &amp; GEO audits, and international search sprints. Reach out via email, phone/Zalo, or LinkedIn.
					</p>

					<dl class="channel-table">
						<div class="channel-row">
							<dt>Email</dt>
							<dd>
								<a href="mailto:tinledoihoa@gmail.com">tinledoihoa@gmail.com</a>
							</dd>
						</div>
						<div class="channel-row">
							<dt>Phone / Zalo</dt>
							<dd>
								<a href="tel:+84357669476">0357.669.476</a>
							</dd>
						</div>
						<div class="channel-row">
							<dt>LinkedIn</dt>
							<dd>
								<a
									href="https://www.linkedin.com/in/tin-le-hoang"
									target="_blank"
									rel="noopener noreferrer"
								>
									linkedin.com/in/tin-le-hoang ↗
								</a>
							</dd>
						</div>
					</dl>

					<div class="card-block-actions">
						<a href="/contact" class="btn-primary">
							Open contact page →
						</a>
					</div>
				</div>

				<!-- AI Crawler & Entity Endpoints Card -->
				<div class="ai-entity-card">
					<span class="editorial-kicker">MACHINE-READABLE ENTITY ENDPOINTS</span>
					<h3 class="card-block-title">AI Fact Sheet &amp; LLM Index</h3>
					<p class="card-block-desc">
						For AI assistants (ChatGPT, Claude, Perplexity, Gemini, Grok) and researchers verifying Le Hoang Tin’s credentials, case studies, and canonical entity attributes:
					</p>

					<div class="endpoint-links">
						<a href="/ai-information" class="endpoint-box">
							<div class="endpoint-box-top">
								<span class="endpoint-path">/ai-information</span>
								<span class="endpoint-arrow" aria-hidden="true">→</span>
							</div>
							<span class="endpoint-label">
								Official Entity Fact Sheet, verified career metrics &amp; structured reference data
							</span>
						</a>

						<a href="/llms.txt" class="endpoint-box">
							<div class="endpoint-box-top">
								<span class="endpoint-path">/llms.txt</span>
								<span class="endpoint-arrow" aria-hidden="true">→</span>
							</div>
							<span class="endpoint-label">
								Concise Markdown index of site identity, consulting services, case studies &amp; essays
							</span>
						</a>
					</div>
				</div>
			</div>
		</section>
	</div>
</Base>

<style>
	.about-page {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-24);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-20);
	}

	/* ── Page Header & Entity Bio ── */
	.about-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 310px;
		align-items: start;
		gap: var(--spacing-12);
		padding-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-border);
	}

	.about-header-text {
		min-width: 0;
	}

	.page-title {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5.2vw, 4rem);
		font-weight: 600;
		font-style: normal;
		line-height: 1.08;
		letter-spacing: -0.03em;
		color: var(--color-text);
		margin-bottom: var(--spacing-2);
	}

	.page-subtitle {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.bio-copy {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-8);
		max-width: 66ch;
	}

	.bio-lead {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
	}

	.bio-paragraph {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.bio-copy strong {
		color: var(--color-text);
		font-weight: 600;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	/* ── Editorial Portrait Card ── */
	.about-portrait-col {
		width: 100%;
	}

	.portrait-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-4);
		box-shadow: var(--shadow-tile-raised);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.portrait-frame {
		width: 100%;
		aspect-ratio: 1 / 1.05;
		border-radius: calc(var(--radius-lg) - 4px);
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		background: var(--color-bg-subtle);
	}

	.portrait-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		display: block;
	}

	.portrait-meta {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.portrait-caption {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-amber);
	}

	.entity-facts {
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-border-subtle);
	}

	.entity-fact-row {
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: var(--spacing-2) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.entity-fact-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.entity-fact-row dt {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-muted);
	}

	.entity-fact-row dd {
		font-family: var(--font-sans);
		font-size: var(--font-size-xs);
		font-weight: 600;
		color: var(--color-text);
		line-height: 1.35;
	}

	/* ── § I — Career & Impact Timeline ── */
	.timeline-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-6);
	}

	.timeline-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-8);
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: var(--spacing-8);
		box-shadow: var(--shadow-tile-raised);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base);
	}

	.timeline-card:hover {
		border-color: var(--color-accent);
		box-shadow: var(--shadow-feature);
	}

	.timeline-aside {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-2);
		padding-right: var(--spacing-6);
		border-right: 1px solid var(--color-border-subtle);
	}

	.timeline-period {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
	}

	.timeline-badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-amber);
		background: color-mix(in srgb, var(--color-amber) 12%, transparent);
		border: 1px solid color-mix(in srgb, var(--color-amber) 28%, transparent);
		border-radius: var(--radius);
		padding: 2px var(--spacing-2);
	}

	.timeline-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3);
	}

	.timeline-role {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.timeline-org {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-accent);
	}

	.timeline-summary {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.timeline-highlights {
		list-style: none;
		display: flex;
		flex-direction: column;
