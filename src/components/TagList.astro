---
interface Props {
  tags: Array<{ slug: string; label: string }>;
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={["tag-list", className]}>
    {tags.map((tag) => (
      <li>
        <a href={`/tag/${tag.slug}`} class="tag">{tag.label}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tag {
    display: inline-block;
    padding: 3px 0.7rem;
    font-family: var(--font-hand);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ll-ink);
    background: var(--ll-slip);
    border: 1.5px solid var(--ll-ink);
    border-radius: var(--ll-radius-chip);
    box-shadow: var(--ll-shadow-hair);
    text-decoration: none;
    transition: color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
  }

  .tag:hover {
    color: var(--ll-ink);
    background: color-mix(in srgb, var(--ll-hi) 50%, var(--ll-slip));
    transform: translateY(-1px) rotate(-0.6deg);
  }
</style>
